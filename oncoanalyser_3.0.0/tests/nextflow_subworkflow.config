// Shared config for subworkflow nf-tests without a test-specific config

// nf-test reuses output dirs across runs, so reports may be overwritten
report   { overwrite = true }
trace    { overwrite = true }
timeline { overwrite = true }
dag      { overwrite = true }

profiles {
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = "${projectDir}/containers"
    }
}

/*
========================================================================================
    Nextflow config for testing clinical template generation (no clinical samplesheet)
========================================================================================
*/

params {
    config_profile_name        = 'Clinical template test profile'
    config_profile_description = 'Test template clinical file generation without a clinical samplesheet'

    mode                        = "clinical"
    input_dir                   = "${projectDir}"

    // No clinical samplesheet — triggers template generation from sample_registrations
    genomic_samplesheet         = "${projectDir}/assets/test_data/samplesheet/test_genomic_2.csv"
    clinical_samplesheet        = ""
    sample_registrations        = "${projectDir}/assets/test_data/clinical/sample_registrations.csv"

    // Unused in clinical template mode but required by config
    ensembl_annotations_expr    = "${projectDir}/assets/test_data/annotations/biomart_grch38_ensembl_113_chr21.tsv"
    ensembl_annotations         = "${projectDir}/assets/test_data/annotations/biomart_grch38_ensembl_113_chr21.tsv"
    genome_reference            = "${projectDir}/assets/test_data/reference/Homo_sapiens_assembly38_chr21.fasta"
    vep_data                    = ""
    vep_params                  = ""
    pcgr_data                   = ""
    cosmic_data                 = ""
    chimer_data                 = ""

    container_r                 = "oras://ghcr.io/crchum-citadel/sdp-r:4.5.1"
    container_python            = "oras://ghcr.io/crchum-citadel/sdp-python:3.12"
    container_pcgr              = "oras://ghcr.io/sigven/pcgr:2.1.2.singularity"
    container_vcf2maf           = ""
    container_sigprofiler       = "oras://ghcr.io/crchum-citadel/sdp-sigprofiler:1.1.3"
}

profiles {
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
    }
}

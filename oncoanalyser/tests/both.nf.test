nextflow_pipeline {

    name "Test both mode pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "both"

    test("both mode — genomic + clinical combined output") {

        config "tests/nextflow_both.config"

        setup {
            // Pre-stage precomputed genomic output files so the incremental processing
            // detects them and skips actual genomic processing (avoids VEP/PCGR downloads).
            def precomputed = "${projectDir}/assets/test_data/precomputed"
            [["T1", "T1-1DT"], ["T2", "T2-T"]].each { subject, sample ->
                def dir = new File("${outputDir}/TEST/${subject}")
                dir.mkdirs()
                def fixtures = [
                    "${sample}_data_cna_hg38.seg",
                    "${sample}_data_cna_long.txt",
                    "${sample}.data_sv.txt",
                    "${sample}.tpm.tsv",
                    "${sample}.somatic_rna_germline.maf",
                    "${sample}.isofox_fusion.data_sv.txt",
                ]
                fixtures.each { name ->
                    java.nio.file.Files.copy(
                        new File("${precomputed}/${name}").toPath(),
                        new File("${dir}/${name}").toPath(),
                        java.nio.file.StandardCopyOption.REPLACE_EXISTING
                    )
                }
            }
        }

        when {
            params {
                mode = 'both'
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // TEST.tar.gz is excluded from stable_path via tests/.nftignore: tar embeds
            // per-file mtimes, so its md5 differs on every run. Its contents are
            // asserted explicitly below instead.
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')

            println "Test: Stable names: ${stable_name}"
            println "Test: Output dir: ${params.outdir}"

            // Verify linking file content — should have both T1 and T2
            def linking = path("${params.outdir}/TEST/util_linking_file.txt").readLines()
            def linking_subjects = linking.findAll { !it.startsWith('subject_id') }.collect { it.split('\t')[0] }.sort()

            // Study archive must mirror the study directory: genomic + clinical + timeline
            def tarball = "${params.outdir}/TEST.tar.gz"
            def tar_entries = ["tar", "-tzf", tarball].execute().text
                .readLines()
                .findAll { it && !it.endsWith('/') }
                .collect { it.split('/').last() }

            // Clinical sample file — T1 deduped to 1 sample (T1-1DT), T2 has 1
            def sample_lines = path("${params.outdir}/TEST/data_clinical_sample.txt").readLines()
                .findAll { !it.startsWith('#') && it.trim() }
            // sample_lines[0] is column header, rest are data rows
            def data_rows = sample_lines.drop(1)

            assertAll(
                { assert workflow.success },
                { assert linking_subjects == ['T1', 'T2'] : "Linking file should contain T1 and T2, got: ${linking_subjects}" },
                { assert data_rows.size() == 2 : "Expected 2 sample rows (T1-1DT, T2), got ${data_rows.size()}" },
                { assert data_rows.count { it.startsWith('T1') } == 1 : "Expected 1 T1 row (deduped)" },
                { assert data_rows.count { it.startsWith('T2') } == 1 : "Expected 1 T2 row" },
                { assert tar_entries.contains('data_clinical_sample.txt') : "Archive missing data_clinical_sample.txt, got: ${tar_entries}" },
                { assert tar_entries.contains('data_clinical_patient.txt') : "Archive missing data_clinical_patient.txt, got: ${tar_entries}" },
                { assert tar_entries.contains('data_timeline.txt') : "Archive missing data_timeline.txt, got: ${tar_entries}" },
                { assert tar_entries.contains('meta_timeline.txt') : "Archive missing meta_timeline.txt, got: ${tar_entries}" },
                { assert tar_entries.contains('util_linking_file.txt') : "Archive missing util_linking_file.txt, got: ${tar_entries}" },
                { assert tar_entries.contains('cases_sequenced.txt') : "Archive missing case lists, got: ${tar_entries}" },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }
}

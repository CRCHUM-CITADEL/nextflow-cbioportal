nextflow_process {

    name "Test FILTER_GERMLINE_DNA"
    script "modules/local/filter_germline_dna/main.nf"
    process "FILTER_GERMLINE_DNA"
    tag "module"
    tag "filter_germline_dna"

    // T1's PURPLE germline fixture: 44300100-500 are ./. and each normal DP/AF exercises one
    // genotype rule or boundary; 600-900 cover PURPLE's own GT and filters (see bin/create_test_data.sh).

    test("default cutoffs — missing GTs inferred from DP/AF, PASS + LOW_TUMOR_VCN only, normal column only") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [group: 'TEST', subject: 'T1', sample: 'T1'],
                    file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/purple/T1-T.purple.germline.vcf.gz')
                ])
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out[0][0][1].toString()).linesGzip
            def header = lines.find { it.startsWith('#CHROM') }.split('\t')
            def records = lines.findAll { !it.startsWith('#') }.collect { it.split('\t') }
            def gt = records.collectEntries { [(it[1]): it[9].split(':')[0]] }

            // The tumour column is dropped; the normal is the only sample left.
            assert header.drop(9) == ['T1-N']
            // LOW_QUAL (500), LOW_VAF (800) and LOW_TUMOR_VCN;LOW_VAF (900) are dropped before inference.
            assert records.collect { it[6] }.unique().sort() == ['LOW_TUMOR_VCN', 'PASS']
            // Reference calls never reach CPSR, which keeps and classifies them in 2.2.5.
            // 44300300 (normal AF 0.15, tumour 0.25) and 44300400 (AF 0.1) are inferred 0/0 and removed.
            assert gt == [
                '44300100': '1/1',  // DP 40, AF 0.95
                '44300150': '1/1',  // AF exactly 0.9
                '44300200': '0/1',  // AF 0.5
                '44300250': '0/1',  // AF exactly 0.2
                '44300350': './.',  // DP 9: too shallow to call, CPSR drops it
                '44300600': '0/1',  // PURPLE's call is kept, though AF 0.95 would infer 1/1
                '44300700': '0/1',  // LOW_TUMOR_VCN: tumour-side flag, the normal's call is kept
            ]
        }
    }

    test("cutoffs come from params") {

        when {
            params {
                germline_min_depth   = 5
                germline_het_min_vaf = 0.1
                germline_hom_min_vaf = 0.95
            }
            process {
                """
                input[0] = Channel.of([
                    [group: 'TEST', subject: 'T1', sample: 'T1'],
                    file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/purple/T1-T.purple.germline.vcf.gz')
                ])
                """
            }
        }

        then {
            assert process.success
            def records = path(process.out[0][0][1].toString()).linesGzip
                .findAll { !it.startsWith('#') }.collect { it.split('\t') }
            def gt = records.collectEntries { [(it[1]): it[9].split(':')[0]] }
            assert gt == [
                '44300100': '1/1',
                '44300150': '0/1',  // 0.9 < hom 0.95
                '44300200': '0/1',
                '44300250': '0/1',
                '44300300': '0/1',  // 0.15 >= het 0.1
                '44300350': '0/1',  // DP 9 >= 5
                '44300400': '0/1',  // AF exactly 0.1, DP exactly 5
                '44300600': '0/1',  // PURPLE's call, not re-inferred
                '44300700': '0/1',
            ]
        }
    }

    test("no FORMAT/AF — the task fails instead of leaving every GT uncalled") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [group: 'TEST', subject: 'T1', sample: 'T1'],
                    file('${projectDir}/tests/modules/fixtures/pave_germline_impact.vcf.gz')
                ])
                """
            }
        }

        then {
            assert process.failed
            assert process.stdout.any { it.contains('has no FORMAT/AF or FORMAT/DP') } ||
                   process.stderr.any { it.contains('has no FORMAT/AF or FORMAT/DP') }
        }
    }
}

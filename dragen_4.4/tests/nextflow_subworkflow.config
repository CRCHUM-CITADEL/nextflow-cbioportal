/*
========================================================================================
    Shared Nextflow config for subworkflow-level nf-test tests.
    Applied via nf-test.config configFile for all tests by default.
========================================================================================
*/

// Allow report/trace/timeline files to be overwritten when nf-test re-uses
// the same output directory across runs (fixed hash per test case).
report   { overwrite = true }
trace    { overwrite = true }
timeline { overwrite = true }
dag      { overwrite = true }

// PCGR and vcf2maf images are multi-GB — the 5 min default pull timeout is not enough.
apptainer.pullTimeout = '60 min'

// Container overrides for offline / GHCR-auth-less execution.
// - container_r: local SIF built from containers/r_v4.5.1.def (or symlinked from oncoanalyser)
// - container_python: local SIF built from containers/python_v3.12.def
// - container_vcf2maf: seqera community image URL (same one nf-core vcf2maf module uses) —
//   no auth required; apptainer pulls ~1.3 GB on first run
// - container_pcgr: sigven/pcgr ORAS URL is public so apptainer can pull it directly
params {
    container_r       = "${projectDir}/containers/ghcr.io-crchum-citadel-sdp-r-4.5.1.sif"
    container_python  = "${projectDir}/containers/ghcr.io-crchum-citadel-sdp-python-3.12.sif"
    container_vcf2maf = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/7c/7cbf9421f0bee23a93a35c5d0c7166ac1e89a40008d8e474cecfddb93226bf65/data"
    container_pcgr    = "oras://ghcr.io/sigven/pcgr:2.1.2.singularity"
}

// Cap per-process resource requests so tests run on modest laptops (< 16 GB RAM).
// Production (SLURM) still uses the full base.config values from conf/base.config.
process {
    resourceLimits = [
        cpus:   2,
        memory: 6.GB,
        time:   2.h
    ]
}

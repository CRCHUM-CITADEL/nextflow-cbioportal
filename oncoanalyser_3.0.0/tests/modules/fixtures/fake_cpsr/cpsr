#!/usr/bin/env bash
# Stand-in for CPSR: names its output after --sample_id, as CPSR does; a sample_id containing EMPTY finds nothing.
set -euo pipefail
id=""
while [ $# -gt 0 ]; do
    case "$1" in
        --sample_id) id="$2"; shift 2 ;;
        *) shift ;;
    esac
done
[[ "$id" == *EMPTY* ]] && exit 0
printf 'VAR_ID\tCLASSIFICATION\n17_43045677_G_A\tPathogenic\n' | gzip > "${id}.cpsr.grch38.classification.tsv.gz"

// PCGR's script against fake_cpsr in the bcftools image (CI runners have no host bcftools)
process {
    withName: 'PCGR' {
        container        = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/47/474a5ea8dc03366b04df884d89aeacc4f8e6d1ad92266888e7a8e7958d07cde8/data'
        // Nextflow starts the container with a clean env, so pass the stand-in's PATH via apptainer.
        containerOptions = "-B ${projectDir}/tests/modules/fixtures --env PREPEND_PATH=${projectDir}/tests/modules/fixtures/fake_cpsr"
        memory           = 1.GB
    }
}

nextflow_process {

    name "Test FILTER_GENE_PANEL"
    script "modules/local/filter_gene_panel/main.nf"
    process "FILTER_GENE_PANEL"
    tag "module"
    tag "filter"

    // Panel shared by the tests: lowercase gene and 'fusion' check case-insensitivity and the sv alias
    def panel = 'gene\\ttype\\n' +
        '# comment line\\n' +
        'TP53\\tmutation\\n' +
        'kras\\tMutation\\n' +
        'DDR2\\tmutation\\n' +
        'ERBB2\\tcna\\n' +
        'ALK\\tfusion\\n' +
        'RET\\tsv\\n' +
        'CCDC6\\tsv\\n'

    def MUTATIONS = 'Hugo_Symbol\\tTumor_Sample_Barcode\\tHGVSp_Short\\n' +
        'TP53\\tS1\\tp.R273H\\n' +
        'DDR2\\tS1\\tp.T93I\\n' +
        'KRAS\\tS2\\tp.G12D\\n' +
        'ERBB2\\tS2\\tp.S310F\\n'

    // Off-panel rows are kept and flagged; DDR2 is dropped by the default exclude_genes even though it is listed
    test("Mutations: flags info.on_panel, drops the excluded gene") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/gp").mkdirs()
                file("${params.outdir}/gp/panel.tsv").text = '${panel}'
                file("${params.outdir}/gp/data_mutations.txt").text = '${MUTATIONS}'
                input[0] = file("${params.outdir}/gp/data_mutations.txt")
                input[1] = file("${params.outdir}/gp/panel.tsv")
                input[2] = 'mutation'
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out[0][0].toString()).readLines()
            assert lines[0] == 'Hugo_Symbol\tTumor_Sample_Barcode\tHGVSp_Short\tinfo.on_panel'
            assert lines.drop(1).collect { it.split('\t').with { c -> [c[0], c[3]] } } ==
                [['TP53', 'true'], ['KRAS', 'true'], ['ERBB2', 'false']]
        }
    }

    test("CNA: only cna genes are on the panel, not mutation-only ones") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/gp").mkdirs()
                file("${params.outdir}/gp/panel.tsv").text = '${panel}'
                file("${params.outdir}/gp/data_cna.txt").text =
                    'Hugo_Symbol\\tSample_Id\\tValue\\n' +
                    'ERBB2\\tS1\\t2\\n' +
                    'TP53\\tS1\\t-2\\n' +
                    'MYC\\tS2\\t2\\n'
                input[0] = file("${params.outdir}/gp/data_cna.txt")
                input[1] = file("${params.outdir}/gp/panel.tsv")
                input[2] = 'cna'
                """
            }
        }

        then {
            assert process.success
            assert path(process.out[0][0].toString()).readLines() == [
                'Hugo_Symbol\tSample_Id\tValue\tinfo.on_panel',
                'ERBB2\tS1\t2\ttrue',
                'TP53\tS1\t-2\tfalse',
                'MYC\tS2\t2\tfalse',
            ]
        }
    }

    // A fusion is on the panel only when both partners are; one with an excluded partner is dropped
    test("SV: on panel only with both partners listed, dropped with either partner excluded") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/gp").mkdirs()
                file("${params.outdir}/gp/panel.tsv").text = '${panel}'
                file("${params.outdir}/gp/data_sv.txt").text =
                    'Sample_Id\\tSite1_Hugo_Symbol\\tSite2_Hugo_Symbol\\tClass\\n' +
                    'S1\\tEML4\\tALK\\tFUSION\\n' +
                    'S1\\tRET\\tCCDC6\\tFUSION\\n' +
                    'S2\\tTMPRSS2\\tERG\\tFUSION\\n' +
                    'S2\\t\\tALK\\tFUSION\\n' +
                    'S2\\tALK\\tddr2\\tFUSION\\n'
                input[0] = file("${params.outdir}/gp/data_sv.txt")
                input[1] = file("${params.outdir}/gp/panel.tsv")
                input[2] = 'sv'
                """
            }
        }

        then {
            assert process.success
            def rows = path(process.out[0][0].toString()).readLines().drop(1).collect { it.split('\t', -1) }
            assert rows.collect { [it[1..2].join('-'), it[4]] } ==
                [['EML4-ALK', 'false'], ['RET-CCDC6', 'true'], ['TMPRSS2-ERG', 'false'], ['-ALK', 'false']]
        }
    }

    // The post-merge pass re-flags cached per-sample files against the current panel
    test("An existing info.on_panel column is overwritten, not duplicated") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/gp").mkdirs()
                file("${params.outdir}/gp/panel.tsv").text = '${panel}'
                file("${params.outdir}/gp/data_cna.txt").text =
                    'Hugo_Symbol\\tinfo.on_panel\\tSample_Id\\tValue\\n' +
                    'ERBB2\\tfalse\\tS1\\t2\\n' +
                    'MYC\\ttrue\\tS2\\t2\\n'
                input[0] = file("${params.outdir}/gp/data_cna.txt")
                input[1] = file("${params.outdir}/gp/panel.tsv")
                input[2] = 'cna'
                """
            }
        }

        then {
            assert process.success
            assert path(process.out[0][0].toString()).readLines() == [
                'Hugo_Symbol\tinfo.on_panel\tSample_Id\tValue',
                'ERBB2\ttrue\tS1\t2',
                'MYC\tfalse\tS2\t2',
            ]
        }
    }

    test("Without a panel: no info.on_panel column, excluded gene still dropped") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/gp").mkdirs()
                file("${params.outdir}/gp/data_mutations.txt").text = '${MUTATIONS}'
                input[0] = file("${params.outdir}/gp/data_mutations.txt")
                input[1] = []
                input[2] = 'mutation'
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out[0][0].toString()).readLines()
            assert lines[0] == 'Hugo_Symbol\tTumor_Sample_Barcode\tHGVSp_Short'
            assert lines.drop(1).collect { it.split('\t')[0] } == ['TP53', 'KRAS', 'ERBB2']
        }
    }

    test("A custom exclude_genes list replaces DDR2, case-insensitively") {

        when {
            params {
                outdir        = "$outputDir"
                exclude_genes = 'erbb2,KRAS'
            }
            process {
                """
                file("${params.outdir}/gp").mkdirs()
                file("${params.outdir}/gp/data_mutations.txt").text = '${MUTATIONS}'
                input[0] = file("${params.outdir}/gp/data_mutations.txt")
                input[1] = []
                input[2] = 'mutation'
                """
            }
        }

        then {
            assert process.success
            assert path(process.out[0][0].toString()).readLines().drop(1).collect { it.split('\t')[0] } == ['TP53', 'DDR2']
        }
    }

    test("Header-only file gets the column in its header") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/gp").mkdirs()
                file("${params.outdir}/gp/panel.tsv").text = '${panel}'
                file("${params.outdir}/gp/data_cna.txt").text = 'Hugo_Symbol\\tSample_Id\\tValue\\n'
                input[0] = file("${params.outdir}/gp/data_cna.txt")
                input[1] = file("${params.outdir}/gp/panel.tsv")
                input[2] = 'cna'
                """
            }
        }

        then {
            assert process.success
            assert path(process.out[0][0].toString()).readLines() == ['Hugo_Symbol\tSample_Id\tValue\tinfo.on_panel']
        }
    }

    test("Fails when the panel lists no genes for the type") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/gp").mkdirs()
                file("${params.outdir}/gp/panel.tsv").text = 'gene\\ttype\\nTP53\\tmutation\\n'
                file("${params.outdir}/gp/data_cna.txt").text = 'Hugo_Symbol\\tSample_Id\\tValue\\nERBB2\\tS1\\t2\\n'
                input[0] = file("${params.outdir}/gp/data_cna.txt")
                input[1] = file("${params.outdir}/gp/panel.tsv")
                input[2] = 'cna'
                """
            }
        }

        then {
            assert process.failed
            assert process.stdout.any { it.contains("lists no 'cna' genes") } || process.errorReport.contains("lists no 'cna' genes")
        }
    }

    test("Fails on an unknown type in the panel") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/gp").mkdirs()
                file("${params.outdir}/gp/panel.tsv").text = 'gene\\ttype\\nTP53\\tsnv\\n'
                file("${params.outdir}/gp/data_mutations.txt").text = 'Hugo_Symbol\\tTumor_Sample_Barcode\\nTP53\\tS1\\n'
                input[0] = file("${params.outdir}/gp/data_mutations.txt")
                input[1] = file("${params.outdir}/gp/panel.tsv")
                input[2] = 'mutation'
                """
            }
        }

        then {
            assert process.failed
        }
    }
}

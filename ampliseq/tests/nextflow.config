/*
========================================================================================
    Shared Nextflow config for subworkflow-level nf-test tests.
    Applied via nf-test.config configFile when no test-specific config is set.
========================================================================================
*/

// Allow report/trace/timeline files to be overwritten when nf-test re-uses
// the same output directory across runs (fixed hash per test case).
report   { overwrite = true }
trace    { overwrite = true }
timeline { overwrite = true }
dag      { overwrite = true }

// The python-ampliseq.sif container is not pre-built in CI.
// Run PACKAGE_CBIOPORTAL without a container (stub only needs touch).
process {
    withName: PACKAGE_CBIOPORTAL {
        container = null
    }
}

/*
    Config for the MAFSMITH module test: runs the real binary with --skip-annotation, so
    no reference bundle is needed (the empty dir passed as mafsmith_data is never read).
    mafsmith then emits records without gene annotation, which is enough to check
    PASS filtering, sample naming, depths and the chr prefix handling.
*/
process {
    memory = 1.GB
    withName: 'MAFSMITH' {
        ext.args = '--skip-annotation'
    }
}

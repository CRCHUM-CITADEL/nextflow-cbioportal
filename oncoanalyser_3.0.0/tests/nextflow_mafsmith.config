/*
========================================================================================
    Nextflow config for the MAFSMITH module test
========================================================================================
    Runs the real mafsmith binary rather than the stub. --skip-annotation bypasses
    fastVEP, so no reference bundle (GFF3 + FASTA) is needed and the empty directory
    passed as mafsmith_data is never read. What remains is exactly what the test
    asserts on: sample-column resolution and allele-depth extraction.
*/

process {
    memory = 1.GB
    withLabel:process_medium_memory { memory = 1.GB }

    withName: 'MAFSMITH' {
        ext.args = '--skip-annotation'
    }
}

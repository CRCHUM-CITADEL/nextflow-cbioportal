/*
========================================================================================
    Nextflow config for running nf-test tests
========================================================================================
*/

// Clinical-only: no genomic input at all, as a real clinical-mode run would have.

params {

    config_profile_name        = 'Clinical test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    mode                        = "clinical"
    study_id                    = "TEST"
    input_dir                   = "${projectDir}"
    genomic_samplesheet         = null

    container_r                 = "oras://ghcr.io/crchum-citadel/sdp-r:4.5.1"
    container_python            = "oras://ghcr.io/crchum-citadel/sdp-python:3.12"

    clinical_samplesheet        = "${projectDir}/assets/test_data/samplesheet/test_clinical.csv"
    sample_registrations        = ""
}


profiles {
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = "${projectDir}/containers"
    }
}

/*
========================================================================================
    Local override config for running nf-test without GHCR authentication.
    Use when containers are built locally from containers/*.def files.
    Usage:
        ./nf-test test tests/subworkflows/<test>.nf.test --profile test,apptainer --config tests/nextflow_local.config
========================================================================================
*/

params {
    // Override ORAS URIs with locally built SIF paths
    container_r       = "${projectDir}/containers/ghcr.io-crchum-citadel-sdp-r-4.5.1.sif"
    container_python  = "${projectDir}/containers/ghcr.io-crchum-citadel-sdp-python-3.12.sif"
    container_pcgr    = "${projectDir}/containers/ghcr.io-sigven-pcgr-2.1.2.singularity.sif"
    container_mafsmith = "${projectDir}/containers/mafsmith_v0.1.0.sif"
}

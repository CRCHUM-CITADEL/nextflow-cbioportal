Bootstrap: docker
From: rust:1.98-bookworm 

%post

%post
    set -eu
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        build-essential \
        pkg-config \
        libssl-dev \
        python3

    git clone --branch v0.1.0 --depth 1 https://github.com/nf-osi/mafsmith.git /tmp/mafsmith
    cd /tmp/mafsmith
    cargo build --release 
    install -m 0755 target/release/mafsmith /usr/local/bin/mafsmith

    cd /
    rm -rf /tmp/mafsmith /usr/local/cargo/registry /usr/local/cargo/git
    apt-get purge -y git build-essential pkg-config libssl-dev
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export CARGO_HOME="${HOME}/.cargo"
    export PATH=/usr/local/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec mafsmith "$@"

%test
    command -v mafsmith
    command -v python3
    mafsmith --help >/dev/null

%help
    mafsmith v0.1.0
    https://github.com/nf-osi/mafsmith

    Examples:
      apptainer exec mafsmith-v0.1.0.sif mafsmith --help
      apptainer run  mafsmith-v0.1.0.sif --help

// PCGR's script against a stand-in cpsr (tests/modules/fixtures/fake_cpsr). It needs only bash and gzip,
// so no container: pulling the multi-GB PCGR image to run a stand-in would be pointless.
apptainer.enabled   = false
singularity.enabled = false
docker.enabled      = false

process {
    withName: 'PCGR' {
        beforeScript = "export PATH=${projectDir}/tests/modules/fixtures/fake_cpsr:\$PATH"
        memory       = 1.GB
    }
}

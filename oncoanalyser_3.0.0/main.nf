#!/usr/bin/env nextflow
// CRCHUM-CITADEL/nextflow-cbioportal — https://github.com/CRCHUM-CITADEL/nextflow-cbioportal

// ── Imports ──

include { GENOMIC   } from './workflows/genomic.nf'
include { CLINICAL  } from './workflows/clinical.nf'
include { PIPELINE_INITIALISATION } from './subworkflows/local/utils'
include { PIPELINE_COMPLETION     } from './subworkflows/local/utils'
include { resource                } from './subworkflows/local/utils'
include { helpRequested           } from './subworkflows/local/utils'
include { runsGenomic             } from './subworkflows/local/utils'
include { PACKAGE_CBIOPORTAL      } from './modules/local/package_cbioportal'

// ── Main workflow ──

workflow {

    main:

    // nf-schema printed the help but cancels the run only after this body starts.
    if (helpRequested()) {
        return
    }

    // Initialisation tasks and checks
    PIPELINE_INITIALISATION (
        params.version,
        params.monochrome_logs,
        args,
        params.mode,
        params.outdir,
        params.genomic_samplesheet,
        params.clinical_samplesheet,
        params.study_id,
        params.project_description,
    )

    // Main workflow
    if (runsGenomic()){

        // Reference files: explicit param, else the resource kit, else '' (download).
        def vep_data      = resource('vep_data')
        def pcgr_data     = resource('pcgr_data')
        def mafsmith_data = resource('mafsmith_data')
        def hotspots_data = resource('cancer_hotspots_data')

        ch_vep_data      = vep_data      ? Channel.fromPath(vep_data)      : Channel.empty()
        ch_pcgr_data     = pcgr_data     ? Channel.fromPath(pcgr_data)     : Channel.empty()
        ch_mafsmith_data = mafsmith_data ? Channel.fromPath(mafsmith_data) : Channel.empty()

        // cosmic_data / chimer_data stay plain params: GENOMIC_ML truth-checks them to decide on ML SV

        ch_hotspots_data = hotspots_data ? Channel.fromPath(hotspots_data).first() : Channel.value([])

        needs_vep_download      = !vep_data
        needs_pcgr_download     = !pcgr_data
        needs_mafsmith_download = !mafsmith_data

        GENOMIC (
            PIPELINE_INITIALISATION.out.genomic_samplesheet,
            resource('ensembl_annotations'),
            ch_vep_data,
            ch_pcgr_data,
            ch_mafsmith_data,
            needs_vep_download,
            needs_pcgr_download,
            needs_mafsmith_download,
            resource('genome_reference'),
            params.cosmic_data,
            resource('chimer_data'),
            ch_hotspots_data,
        )
    }

    if (params.mode == 'clinical'){
        // Optional --genomic_samplesheet: keep only its subjects, exactly as both mode does with its linking file.
        ch_genomic_subjects = params.genomic_samplesheet
            ? PIPELINE_INITIALISATION.out.genomic_samplesheet
                .map { row -> "${row[0].subject}\t${row[0].sample}" }
                .unique()
                .collectFile(name: 'genomic_subjects.tsv', seed: "subject_id\tsample_id\n", newLine: true, sort: true)
                .map { f -> f.toString() }
                .first()
            : Channel.value("")

        CLINICAL(
            PIPELINE_INITIALISATION.out.clinical_samplesheet,
            params.sample_registrations,
            ch_genomic_subjects,
            Channel.value([]),
        )
    }

    if (params.mode == 'both'){
        // In "both" mode, the linking file is generated by GENOMIC — wait for it
        ch_linking_file = GENOMIC.out.linking_file
            .map { group, f -> f }
            .first()

        // Pass the linking file path as a string so BUILD_CLINICAL_TABLE can filter to genomic subjects
        ch_genomic_subjects = GENOMIC.out.linking_file
            .map { group, f -> f.toString() }
            .first()

        // Merged TMB/HRD sample attributes, joined onto data_clinical_sample.txt by CLINICAL ([] if none)
        ch_genomic_attributes = GENOMIC.out.sample_attributes
            .map { group, f -> f }
            .toList()
            .map { files -> files ? files[0] : [] }
        CLINICAL(
            PIPELINE_INITIALISATION.out.clinical_samplesheet,
            ch_linking_file,
            ch_genomic_subjects,
            ch_genomic_attributes,
        )
    }

    // Packaged here, not in GENOMIC, so the "both" archive has the clinical files; clinical-only is not packaged
    if (runsGenomic()) {
        ch_package_files = GENOMIC.out.package_files

        if (params.mode == 'both') {
            ch_package_files = ch_package_files.mix(CLINICAL.out.package_files)
        }

        PACKAGE_CBIOPORTAL(ch_package_files.groupTuple())
    }

    // Completion tasks
    PIPELINE_COMPLETION (
        params.email,
        params.email_on_fail,
        params.plaintext_email,
        params.outdir,
        params.monochrome_logs,
        params.hook_url,
    )
}

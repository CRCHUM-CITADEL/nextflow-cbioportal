nextflow_workflow {

    name "Test CLINICAL_AGGREGATE subworkflow"
    script "subworkflows/local/clinical_aggregate/main.nf"
    workflow "CLINICAL_AGGREGATE"
    tag "subworkflow"
    tag "clinical"

    test("All file types — clinical output files are produced") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                // Each tuple: (meta with group/pipeline/extraction_date, csv_file)
                input[0] = Channel.of(
                    [
                        [group: 'TEST', pipeline: 'donors',               extraction_date: '2025-05-20'],
                        file('${projectDir}/assets/test_data/clinical/donors.csv')
                    ],
                    [
                        [group: 'TEST', pipeline: 'primary_diagnoses',    extraction_date: '2025-05-20'],
                        file('${projectDir}/assets/test_data/clinical/primary_diagnoses.csv')
                    ],
                    [
                        [group: 'TEST', pipeline: 'treatments',           extraction_date: '2025-05-20'],
                        file('${projectDir}/assets/test_data/clinical/treatments.csv')
                    ],
                    [
                        [group: 'TEST', pipeline: 'surgeries',            extraction_date: '2025-05-20'],
                        file('${projectDir}/assets/test_data/clinical/surgeries.csv')
                    ],
                    [
                        [group: 'TEST', pipeline: 'systemic_therapies',   extraction_date: '2025-05-20'],
                        file('${projectDir}/assets/test_data/clinical/systemic_therapies.csv')
                    ],
                    [
                        [group: 'TEST', pipeline: 'specimens',            extraction_date: '2025-05-20'],
                        file('${projectDir}/assets/test_data/clinical/specimens.csv')
                    ],
                    [
                        [group: 'TEST', pipeline: 'radiations',           extraction_date: '2025-05-20'],
                        file('${projectDir}/assets/test_data/clinical/radiations.csv')
                    ],
                    [
                        [group: 'TEST', pipeline: 'follow_ups',           extraction_date: '2025-05-20'],
                        file('${projectDir}/assets/test_data/clinical/follow_ups.csv')
                    ],
                    [
                        [group: 'TEST', pipeline: 'sample_registrations', extraction_date: '2025-05-20'],
                        file('${projectDir}/assets/test_data/clinical/sample_registrations.csv')
                    ],
                    [
                        [group: 'TEST', pipeline: 'biomarkers',           extraction_date: '2025-05-20'],
                        file('${projectDir}/assets/test_data/clinical/biomarkers.csv')
                    ]
                )
                """
            }
        }

        then {
            assert workflow.success

            assert path("${params.outdir}/TEST/data_clinical_sample.txt").exists()
            assert path("${params.outdir}/TEST/data_clinical_patient.txt").exists()

            // Verify clinical sample file format
            def sample_header = path("${params.outdir}/TEST/data_clinical_sample.txt").readLines()[0]
            assert sample_header.startsWith('#')

            // Verify meta files are created
            assert path("${params.outdir}/TEST/meta_clinical_sample.txt").exists()
            assert path("${params.outdir}/TEST/meta_clinical_patient.txt").exists()

            snapshot(
                path("${params.outdir}/TEST/data_clinical_sample.txt"),
                path("${params.outdir}/TEST/data_clinical_patient.txt")
            ).match()
        }
    }
}

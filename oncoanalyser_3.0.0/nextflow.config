// Portable defaults only; site-specific values live in nextflow_citadel.config.
params {

    mode                = "both" // genomic | clinical | both

    study_id            = ""
    project_description = ""
    cancer_type         = ""
    // Follow-up load into an existing study: skip cancer_type.txt / meta_cancer_type.txt.
    incremental         = false

    // null, not "": nf-schema >= 2.7 validates empty strings against the path format.
    genomic_samplesheet        = null
    clinical_samplesheet       = null
    // Clinical mode without a clinical_samplesheet only; "both" mode uses the linking file.
    sample_registrations       = ""

    // Reference files come from the resource kit (docs/resources.md); any one can still be overridden, e.g. --vep_data.
    resources_dir              = null
    resources_version          = "1.0.0"

    // fastVEP CSQ subfields appended to the MAF; an unknown name yields an empty column.
    mafsmith_retain_ann        = "Consequence,IMPACT,SYMBOL,Feature_type,CCDS,EXON,INTRON,Existing_variation,CLIN_SIG,AF"

    // Licence-gated, never in the kit; ML SV needs it alongside the kit's ChimerKB.
    cosmic_data                = ""

    container_mafsmith           = "oras://ghcr.io/crchum-citadel/mafsmith-fastvep:0.1.0-0.4.0"
    container_python             = "oras://ghcr.io/crchum-citadel/sdp-python:3.12"
    container_r                  = "oras://ghcr.io/crchum-citadel/sdp-r:4.5.1"
    // PCGR 2.3.x only accepts bundle 20260620 + VEP 115: bump image, bundle and cache together.
    container_pcgr               = "oras://ghcr.io/sigven/pcgr:2.3.2.singularity"
    container_sigprofiler        = "oras://ghcr.io/crchum-citadel/sigprofiler:1.1.3"

    outdir                       = 'output'
    input_dir                    = "${projectDir}"
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = null
    version                      = false
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
    config_profile_name          = null
    config_profile_description   = null

    custom_config_version        = 'master'
    custom_config_base           = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact       = null
    config_profile_url           = null
}

includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    apptainer {
        apptainer.enabled             = true
        apptainer.autoMounts          = true
        apptainer.pullTimeout         = "5 min"
        // Site configs override this, e.g. with a shared cache (nextflow_citadel.config).
        apptainer.cacheDir            = "${projectDir}/containers"
    }
    slurm {
        executor {
            name = 'slurm'
            queueSize = 1000
            submitRateLimit = '10 sec'
            pollInterval = '30 sec'
            queueStatInterval = '5 min'
            exitReadTimeout = '90 sec'
        }

        process {
            executor = 'slurm'
            cpus = 1
            memory = '1 GB'
            time = '5 min'
            errorStrategy = 'retry'
            maxRetries = 2
        }
    }
    // List LAST so it wins on overlap: -profile slurm,apptainer,citadel
    citadel {
        includeConfig 'nextflow_citadel.config'
    }
    // Locally built .sif files, for when GHCR auth is unavailable: -profile test,apptainer,local
    local {
        params {
            container_r       = "${projectDir}/containers/ghcr.io-crchum-citadel-sdp-r-4.5.1.sif"
            container_python  = "${projectDir}/containers/ghcr.io-crchum-citadel-sdp-python-3.12.sif"
            container_pcgr          = "${projectDir}/containers/ghcr.io-sigven-pcgr-2.3.2.singularity.sif"
            container_sigprofiler   = "${projectDir}/containers/ghcr.io-crchum-citadel-sdp-sigprofiler-1.1.3.sif"
            container_mafsmith      = "${projectDir}/containers/mafsmith-fastvep_v0.1.0-0.4.0.sif"
        }
    }
    test {
        process {
            maxForks = 4
            resourceLimits = [
                cpus: 1,
                memory: '30.GB',
                time: '2.h'
            ]
        }
        params {
                mode                        = "genomic"
                input_dir                   = "${projectDir}"
                resources_dir               = "${projectDir}/assets/test_data/resources"
                genomic_samplesheet         = "${projectDir}/assets/test_data/samplesheet/test_genomic_2.csv"
                ensembl_annotations         = "${projectDir}/assets/test_data/annotations/biomart_grch38_ensembl_113_test.tsv"
                genome_reference            = "${projectDir}/assets/test_data/reference/Homo_sapiens_assembly38_chr21.fasta"
                // Placeholder: mafsmith.nf.test runs with --skip-annotation.
                mafsmith_data               = "${projectDir}/assets/test_data"

                // Stays on 2.1.2 to match the test downloads (VEP 112 chr21, bundle 20240927).
                container_pcgr              = "oras://ghcr.io/sigven/pcgr:2.1.2.singularity"
                container_r                 = "oras://ghcr.io/crchum-citadel/sdp-r:4.5.1"
                container_python            = "oras://ghcr.io/crchum-citadel/sdp-python:3.12"
                container_mafsmith          = "oras://ghcr.io/crchum-citadel/mafsmith-fastvep:0.1.0-0.4.0"
                container_sigprofiler       = "oras://ghcr.io/crchum-citadel/sigprofiler:1.1.3"

                clinical_samplesheet        = "${projectDir}/assets/test_data/samplesheet/test_clinical.csv"
                sample_registrations        = ""
        }
    }
}

includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

singularity.registry  = 'ghcr.io'

// Keep host Python/R libraries out of the containers.
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

process {
    shell = ["bash", "-C", "-e", "-u", "-o", "pipefail"]
    withName: 'MAFSMITH' {
        beforeScript = 'mkdir -p "$PWD/tmp" && export "TMPDIR=$PWD/tmp"'
    }
    withName: 'BCFTOOLS_INDEX' {
        ext.args = '--tbi'
    }
}

// Enabled by the debug profile.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'CRCHUM-CITADEL/nextflow-cbioportal'
    contributors    = [
        [
            name: 'Justin Bellavance',
            affiliation: 'CITADEL',
            email: 'justin.bellavance.chum@ssss.gouv.qc.ca',
            github: 'JustinBellavance',
            contribution: [],
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/CRCHUM-CITADEL/nextflow-cbioportal'
    description     = """Nextflow pipeline: nf-core/oncoanalyser outputs -> cBioPortal-ready files"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.04.4'
    version         = '4.0.0'
    doi             = ''
}

plugins {
    id 'nf-schema@2.8.0'
}

// --help prints the parameter groups from nextflow_schema.json; --help <param> details one.
validation {
    help {
        enabled = true
        command = "nextflow run main.nf -profile slurm,apptainer --mode genomic --genomic_samplesheet samplesheet.csv --resources_dir /path/to/kit --outdir results"
    }
}

includeConfig 'conf/modules.config'

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CRCHUM-CITADEL/nextflow-cbioportal — CRCHUM / CITADEL site configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Site-specific settings for the CRCHUM HPC (Alliance Canada). Everything in
    here is local to our infrastructure — absolute reference-data paths, prebuilt
    .sif containers, the SLURM account and scratch space, and our notification
    address. nextflow.config carries only portable defaults, so an external team
    can run the pipeline without editing site paths out of it.

    Usage (CRCHUM):
        nextflow run main.nf -profile slurm,apptainer,citadel --mode both ...

    List `citadel` LAST so its values win wherever profiles overlap.
    (Equivalently: -c nextflow_citadel.config)
----------------------------------------------------------------------------------------
*/

params {
    // ── Reference data staged on the CRCHUM shared filesystem ────────────────
    // Compute nodes have no internet, so everything is pre-staged on /project.
    ensembl_annotations      = "/project/60005/shared/resources/genomes/grch38/annotations/ensembl/biomart_grch38_ensembl_113_with_entrez_id.tsv"  // BioMart TSV — PURPLE CNV gene→Entrez mapping, ESVEE breakpoint gene annotation, Isofox expression Ensembl→Entrez mapping

    vep_data                 = "/project/60005/shared/software/ensembl-vep-release-113.0/cache"   // used by PCGR
    pcgr_data                = "/project/60005/shared/resources/genomes/grch38/pcgr_ref_data"

    // mafsmith home — pre-staged rather than fetched, so its reference matches the
    // genome SAGE aligned against (the auto-download would pull Ensembl contig names)
    mafsmith_data            = "/project/60005/shared/software/mafsmith_0.1.0/"

    genome_reference         = "/project/60005/shared/resources/genomes/grch38/dragen_cqgc/Homo_sapiens_assembly38.fasta"

    cosmic_data              = "/project/60005/shared/resources/cosmic_fusions/Cosmic_Fusion_v103_GRCh38.tsv"

    // ── Containers prebuilt as .sif on the shared filesystem ─────────────────
    // Same images as the public oras:// defaults in nextflow.config, pulled once
    // so compute nodes never need registry access.
    container_python         = "/project/60005/shared/sub_projects/cbioportal_nextflow/containers/ghcr.io-crchum-citadel-sdp-python-3.12.sif"
    container_r              = "/project/60005/shared/sub_projects/cbioportal_nextflow/containers/ghcr.io-crchum-citadel-sdp-r-4.5.1.sif"
    container_pcgr           = "/project/60005/shared/sub_projects/cbioportal_nextflow/containers/ghcr.io-sigven-pcgr-2.2.5.sif"
    container_sigprofiler    = "/project/60005/shared/sub_projects/cbioportal_nextflow/containers/sigprofiler_v1.1.3.sif"
    container_mafsmith       = "/project/60005/shared/sub_projects/cbioportal_nextflow/containers/mafsmith_v0.1.0.sif"

    // ── Site conventions ─────────────────────────────────────────────────────
    outdir                   = 'output_mohq_cm_' + new java.util.Date().format('yyyy-MM-dd')
    email                    = 'justin.bellavance.chum@ssss.gouv.qc.ca'
    email_on_fail            = 'justin.bellavance.chum@ssss.gouv.qc.ca'
}

// Shared Apptainer image cache, so a pulled image is reused across runs and users.
apptainer.cacheDir = "/project/60005/shared/scratch/"

// SLURM settings specific to our allocation. The generic `slurm` profile in
// nextflow.config carries only the portable executor tuning; these are the bits
// that are ours (RAP account, scratch space, job-array size).
process {
    clusterOptions = '--account=def-chasse'
    scratch        = '/project/60005/shared/scratch/'
    array          = 300
}

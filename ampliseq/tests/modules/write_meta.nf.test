nextflow_process {

    name "Test WRITE_META"
    script "modules/local/write_meta/main.nf"
    process "WRITE_META"
    tag "module"

    // The namespaces make cBioPortal import and show ANNOTATE_GNOMAD's gnomAD.* and ClinVar.* columns
    test("Declares the gnomAD and ClinVar namespaces with filter_gnomad_af") {

        when {
            params {
                outdir           = "$outputDir"
                filter_gnomad_af = true
            }
            process {
                """
                input[0] = 'test_study'
                """
            }
        }

        then {
            assert process.success
            def meta = process.out[0][0].find { it.toString().endsWith('meta_mutations.txt') }
            assert path(meta.toString()).readLines().contains('namespaces: gnomAD,ClinVar')
        }
    }

    test("Declares the namespaces with filter_clinvar alone") {

        when {
            params {
                outdir         = "$outputDir"
                filter_clinvar = true
            }
            process {
                """
                input[0] = 'test_study'
                """
            }
        }

        then {
            assert process.success
            def meta = process.out[0][0].find { it.toString().endsWith('meta_mutations.txt') }
            assert path(meta.toString()).readLines().contains('namespaces: gnomAD,ClinVar')
        }
    }

    test("No namespace without the Genome Nexus filters") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = 'test_study'
                """
            }
        }

        then {
            assert process.success
            def meta = process.out[0][0].find { it.toString().endsWith('meta_mutations.txt') }
            assert !path(meta.toString()).text.contains('namespaces:')
        }
    }
}

// PCGR's script against fake_cpsr: needs only bash and gzip, so no container
apptainer.enabled   = false
singularity.enabled = false
docker.enabled      = false

process {
    withName: 'PCGR' {
        beforeScript = "export PATH=${projectDir}/tests/modules/fixtures/fake_cpsr:\$PATH"
        memory       = 1.GB
    }
}

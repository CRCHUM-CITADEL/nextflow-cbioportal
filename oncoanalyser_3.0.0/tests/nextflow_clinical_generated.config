/*
========================================================================================
    Nextflow config for testing clinical pipeline with a generated samplesheet
========================================================================================
*/

params {

    config_profile_name        = 'Clinical generated samplesheet test profile'
    config_profile_description = 'Verify the pipeline accepts a samplesheet produced by generate_clinical_samplesheet.py'

    mode                        = "clinical"
    input_dir                   = "${projectDir}"

    // null: a genomic samplesheet would filter clinical output to its subjects.
    genomic_samplesheet         = null

    container_r                 = "oras://ghcr.io/crchum-citadel/sdp-r:4.5.1"
    container_python            = "oras://ghcr.io/crchum-citadel/sdp-python:3.12"

    study_id                    = "TEST"

    // Samplesheet produced by generate_clinical_samplesheet.py
    clinical_samplesheet        = "${projectDir}/assets/test_data/samplesheet/test_clinical_generated.csv"
    sample_registrations        = ""
}

profiles {
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = "${projectDir}/containers"
    }
}

/*
========================================================================================
    Nextflow config file for running nf-test tests in "both" mode
========================================================================================
*/

params {

    config_profile_name        = 'Both mode test profile'
    config_profile_description = 'Test dataset to check combined genomic + clinical pipeline'

    // Input data
    mode                        = "both"
    study_id                    = "TEST"
    input_dir                   = "${projectDir}"
    genomic_samplesheet         = "${projectDir}/assets/test_data/samplesheet/test_genomic_2.csv"
    ensembl_annotations         = "${projectDir}/assets/test_data/annotations/biomart_grch38_ensembl_113_chr21.tsv"
    ensembl_annotations_expr    = "${projectDir}/assets/test_data/annotations/biomart_grch38_ensembl_113_chr21.tsv"
    genome_reference            = "${projectDir}/assets/test_data/reference/Homo_sapiens_assembly38_chr21.fasta"
    // Pre-staged data to prevent downloads (genomic subjects are pre-staged via
    // incremental processing, so these are never actually consumed)
    vep_data                    = "${projectDir}/assets/vep"
    vep_params                  = "--cache-version 112 --ncbi-build=GRCh38 --test"
    pcgr_data                   = "${projectDir}/assets/test_data"
    cosmic_data                 = ""
    chimer_data                 = ""

    container_r                 = "oras://ghcr.io/crchum-citadel/sdp-r:4.5.1"
    container_python            = "oras://ghcr.io/crchum-citadel/sdp-python:3.12"
    container_pcgr              = "oras://ghcr.io/sigven/pcgr:2.1.2.singularity"
    container_vcf2maf           = "oras://ghcr.io/crchum-citadel/vcf2maf_ensembl-vep:v1.6.22_2"

    // cancer type generation
    generate_cancer_type        = true

    // clinical params:
    clinical_samplesheet        = "${projectDir}/assets/test_data/samplesheet/test_clinical.csv"
    sample_registrations        = ""
}


// Override resource limits for test environment (pre-staged genomic outputs
// means only aggregation + ML runs; reduce memory so tests pass on small VMs)
process {
    memory = 1.GB
    withLabel:process_single       { memory = 1.GB }
    withLabel:process_low          { memory = 1.GB }
    withLabel:process_medium       { memory = 1.GB }
    withLabel:process_medium_memory { memory = 1.GB }
    withLabel:process_high         { memory = 1.GB }
    withLabel:process_high_memory  { memory = 1.GB }
}

profiles {
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
    }
}

nextflow.enable.types = true
params {
	gtf_gz      	= "/lustre06/project/6006361/shared/citadelomique/software/kallisto-0.51.0/grch38_index/Homo_sapiens.GRCh38.108.gtf.gz"
	outputDir 	= "output"
	container_r     = "/scratch/justb11/soins_intensifs-cbioportal/containers/sdp-r_4.5.1.sif"
}

process {
	withName: 'OARFISH_EXPRESSION_TO_CBIOPORTAL|JOIN_EXPRESSION' {
		container = params.container_r
	}
}

apptainer {
	enabled		= true
	autoMounts	= true
	cacheDir	= '/scratch/justb11/apptainer_cache'
}

nextflow_process {

    name "Test CONVERT_CPSR_TO_MAF"
    script "modules/local/convert_cpsr_to_maf/main.nf"
    process "CONVERT_CPSR_TO_MAF"
    tag "module"
    tag "convert_cpsr_to_maf"

    // The input MAF here carries exactly the 53 columns mafsmith emits, not the ~133
    // vcf2maf used to. gen_convert_cpsr_to_maf.R builds its germline rows by assigning
    // into a list keyed on the incoming header, and `list$X <- v` APPENDS when X is not
    // already a slot — so a name the MAF does not carry (Consequence, IMPACT, FILTER,
    // Feature_type, CCDS, RefSeq) used to widen the row past the header and produce a
    // ragged file rather than an error. The row-width assertion below is what guards it.
    test("mafsmith-shaped MAF — every row matches the header width") {

        config "tests/nextflow_mutations.config"

        when {
            process {
                """
                input[0] = Channel.of([
                    'T1',
                    [group: 'TEST', subject: 'T1', sample: 'T1'],
                    file('${projectDir}/tests/modules/fixtures/mafsmith_somatic_rna.maf'),
                    [group: 'TEST', subject: 'T1', sample: 'T1-N'],
                    file('${projectDir}/tests/modules/fixtures/cpsr_germline.tsv.gz')
                ])
                """
            }
        }

        then {
            assert process.success

            def maf = path(process.out[0][0][1].toString())
            def lines = maf.readLines()

            assert lines[0].startsWith('#version')
            def width = lines[1].split('\t', -1).size()
            assert width == 53 : "header lost or gained columns: ${width}"

            // No row may be wider or narrower than the header it is written under.
            lines.drop(2).eachWithIndex { line, i ->
                def n = line.split('\t', -1).size()
                assert n == width : "row ${i + 1} has ${n} fields, header has ${width}"
            }

            // The module's own filter drops Intron/IGR rows on field 9.
            assert !lines.drop(2).any { it.split('\t', -1)[8] in ['Intron', 'IGR'] }

            // Germline variants from the CPSR TSV are merged in alongside the somatic
            // rows — this is what the file's name promises.
            def header = lines[1].split('\t', -1) as List
            def statusCol = header.indexOf('Mutation_Status')
            def symbolCol = header.indexOf('Hugo_Symbol')
            def rows = lines.drop(2).collect { it.split('\t', -1) }

            assert rows.any { it[statusCol] == 'Somatic' }  : "somatic rows lost"
            assert rows.any { it[statusCol] == 'Germline' } : "no germline rows merged in"
            assert rows.find { it[statusCol] == 'Germline' }[symbolCol] == 'BRCA1'

            // The filter reads CPSR's final CLASSIFICATION, not CLINVAR_CLASSIFICATION: the
            // ClinVar-pathogenic row and the stop-gain ClinVar has never seen (empty
            // CLINVAR_CLASSIFICATION, CPSR's own call Likely Pathogenic) both survive; the
            // Benign row must not appear.
            def startCol = header.indexOf('Start_Position')
            def germline = rows.findAll { it[statusCol] == 'Germline' }
            assert germline*.getAt(startCol).sort() == ['43045677', '43045700'] :
                "expected the ClinVar and the novel germline call, got ${germline*.getAt(startCol)}"
        }
    }

    test("cpsr <= 2.1 output — falls back to FINAL_CLASSIFICATION") {

        config "tests/nextflow_mutations.config"

        when {
            process {
                """
                input[0] = Channel.of([
                    'T1',
                    [group: 'TEST', subject: 'T1', sample: 'T1'],
                    file('${projectDir}/tests/modules/fixtures/mafsmith_somatic_rna.maf'),
                    [group: 'TEST', subject: 'T1', sample: 'T1-N'],
                    file('${projectDir}/tests/modules/fixtures/cpsr_germline_final_classification.tsv.gz')
                ])
                """
            }
        }

        then {
            assert process.success

            def lines = path(process.out[0][0][1].toString()).readLines()
            def header = lines[1].split('\t', -1) as List
            def statusCol = header.indexOf('Mutation_Status')
            def startCol = header.indexOf('Start_Position')
            def germline = lines.drop(2).collect { it.split('\t', -1) }.findAll { it[statusCol] == 'Germline' }

            // Same rows as above, from the older column name and its Likely_Pathogenic spelling.
            assert germline*.getAt(startCol).sort() == ['43045677', '43045700']
        }
    }
}

/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements

params {

    config_profile_name        = 'Genomic test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    mode                		= "genomic"
    input_dir           		= "${projectDir}"
    genomic_samplesheet 		= "${projectDir}/assets/test_data/samplesheet/test_genomic_2.csv"
    ensembl_annotations 		= "${projectDir}/assets/test_data/annotations/biomart_grch38_ensembl_113_test.tsv"
    genome_reference    		= "${projectDir}/assets/test_data/reference/Homo_sapiens_assembly38_chr21.fasta"
    vep_data					= "" // if empty, will attempt to download the chr21 test data set
    // COSMIC fusions + ChimerKB are all-or-nothing (FORMAT_PROCESS_ML_SV unions them).
    // This used to point cosmic_data at the ChimerKB workbook, which is the wrong file.
    cosmic_data         		= "${projectDir}/assets/test_data/annotations/cosmic_fusion_test.tsv"
    chimer_data         		= "${projectDir}/assets/test_data/annotations/ChimerKB4.xlsx"
    pcgr_data           		= "" // if empty, will attempt to download from wget https://insilico.hpc.uio.no/pcgr/pcgr_ref_data.20240621.grch38.tgz
    mafsmith_data       		= "${projectDir}/assets/test_data" // mafsmith has no download fallback

    container_r        			= "oras://ghcr.io/crchum-citadel/sdp-r:4.5.1"
    container_python    		= "oras://ghcr.io/crchum-citadel/sdp-python:3.12"
    container_pcgr      		= "oras://ghcr.io/sigven/pcgr:2.1.2.singularity"
    container_mafsmith  		= "oras://ghcr.io/crchum-citadel/mafsmith:0.1.0"

    // clinical params:
    clinical_samplesheet  		= "${projectDir}/assets/test_data/samplesheet/test_clinical.csv"
    sample_registrations  		= ""
}


profiles {
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
    }
}

/*
========================================================================================
    Nextflow config for the GENOMIC_MUTATIONS subworkflow test
========================================================================================
    MAFSMITH needs its pre-fetched reference bundle (params.mafsmith_data), which is a
    site path with no public download, so this subworkflow cannot run for real in CI.
    The test runs under -stub-run and asserts the wiring instead.
*/

params {

    config_profile_name        = 'Mutations subworkflow test profile'
    config_profile_description = 'Stub-level wiring check for GENOMIC_MUTATIONS'

    input_dir                   = "${projectDir}"
    mafsmith_data               = "${projectDir}/assets/test_data/clinical"
}

process {
    memory = 1.GB
    withLabel:process_single        { memory = 1.GB }
    withLabel:process_low           { memory = 1.GB }
    withLabel:process_medium        { memory = 1.GB }
    withLabel:process_medium_memory { memory = 1.GB }
    withLabel:process_high          { memory = 1.GB }
    withLabel:process_high_memory   { memory = 1.GB }
}

report   { overwrite = true }
trace    { overwrite = true }
timeline { overwrite = true }
dag      { overwrite = true }

// Stub scripts are plain shell — no container is needed, and pulling PCGR (~8 GB)
// for a `touch` only wastes CI time and invites registry-auth failures. A `-c`
// config outranks the profile, so this holds under `--profile test,apptainer`.
apptainer.enabled = false
singularity.enabled = false
docker.enabled = false

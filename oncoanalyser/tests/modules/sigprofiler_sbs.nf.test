nextflow_process {

    name "Test SIGPROFILER_SBS module"
    script "modules/local/sigprofiler_sbs/main.nf"
    process "SIGPROFILER_SBS"
    tag "module"
    tag "sigs"

    test("Two subjects — data_mutational_signatures_contribution_SBS.txt files are produced") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1', pipeline: 'sigs'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/sigs/T1-T.sig.snv_counts.csv')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2', pipeline: 'sigs'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T2/sigs/T2-T.sig.snv_counts.csv')
                    ]
                )
                input[1] = file('${projectDir}/assets/COSMIC_Human_v3.6.zip')
                input[2] = file('${projectDir}/assets/cosmic_sbs_metadata.tsv')
                """
            }
        }

        then {
            assert process.success
            assert process.out.sigs.size() == 2

            def names = process.out.sigs.collect { meta, f -> f.toString().split('/').last() }.sort()
            assert names == ['T1.data_mutational_signatures_contribution_SBS.txt', 'T2.data_mutational_signatures_contribution_SBS.txt']

            // Verify cBioPortal GENERIC_ASSAY format columns
            def t1_path = process.out.sigs.collect { meta, f -> f }.find { it.toString().endsWith('T1.data_mutational_signatures_contribution_SBS.txt') }
            def header = path(t1_path.toString()).readLines()[0]
            assert header.contains('ENTITY_STABLE_ID')
            assert header.contains('NAME')
            assert header.contains('DESCRIPTION')
            assert header.contains('T1')

            // Verify ENTITY_STABLE_ID uses COSMIC v3.6 SBS naming (e.g., SBS1, SBS5, SBS7a)
            def t1_lines = path(t1_path.toString()).readLines()
            assert t1_lines.size() > 1
            def entity_ids = t1_lines[1..-1].collect { it.split('\t')[0] }
            assert entity_ids.any { it.startsWith('mutational_signatures_contribution_SBS') }

            snapshot(
                process.out.sigs.collect { meta, f -> path(f.toString()) }.sort { it.toString().split('/').last() }
            ).match()
        }
    }
}

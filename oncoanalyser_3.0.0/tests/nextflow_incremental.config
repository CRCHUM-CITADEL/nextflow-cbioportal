/*
========================================================================================
    Nextflow config for the pipeline-level incremental-processing tests
========================================================================================
    Runs under -stub-run: every process emits empty placeholder files, so the only
    real content in the merged study files comes from the per-subject fixtures
    pre-staged into the output directory. That is exactly what makes it possible to
    tell a cached subject apart from a freshly (stub-)processed one.
*/

params {

    config_profile_name        = 'Incremental test profile'
    config_profile_description = 'Skip already-processed subjects and merge them with new ones'

    mode                        = "genomic"
    study_id                    = "TEST"
    input_dir                   = "${projectDir}"
    // genomic_samplesheet is written per test into the output dir, with absolute
    // folder paths — the checked-in samplesheet uses paths relative to the launch
    // directory, which is not the project root under nf-test.
    ensembl_annotations         = "${projectDir}/assets/test_data/annotations/biomart_grch38_ensembl_113_test.tsv"
    genome_reference            = "${projectDir}/assets/test_data/reference/Homo_sapiens_assembly38_chr21.fasta"

    // Point at directories that exist in the repo so needs_vep / needs_pcgr stay
    // false and no download process is reachable. Their content is never read under
    // -stub-run, but they must have DIFFERENT basenames: PCGR stages both at once
    // and two inputs named "annotations" is a staging collision.
    vep_data                    = "${projectDir}/assets/test_data/annotations"
    pcgr_data                   = "${projectDir}/assets/test_data/reference"
    mafsmith_data               = "${projectDir}/assets/test_data/clinical"
    cosmic_data                 = ""
    chimer_data                 = ""

    container_r                 = "oras://ghcr.io/crchum-citadel/sdp-r:4.5.1"
    container_python            = "oras://ghcr.io/crchum-citadel/sdp-python:3.12"
    container_pcgr              = "oras://ghcr.io/sigven/pcgr:2.1.2.singularity"
    container_mafsmith          = "oras://ghcr.io/crchum-citadel/mafsmith:0.1.0"

    // A follow-up load: no cancer_type.txt, matching what these tests assert on.
    incremental                 = true
}

process {
    memory = 1.GB
    withLabel:process_single        { memory = 1.GB }
    withLabel:process_low           { memory = 1.GB }
    withLabel:process_medium        { memory = 1.GB }
    withLabel:process_medium_memory { memory = 1.GB }
    withLabel:process_high          { memory = 1.GB }
    withLabel:process_high_memory   { memory = 1.GB }
}

profiles {
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
    }
}

// Stub scripts are plain shell — no container is needed, and pulling one for a
// `touch` only invites registry-auth failures. A `-c` config outranks the profile,
// so this holds even when the suite is run with `--profile test,apptainer`.
apptainer.enabled = false
singularity.enabled = false
docker.enabled = false

nextflow_process {

    name "Test WRITE_CLINICAL_SAMPLE module"
    script "modules/local/write_clinical_sample/main.nf"
    process "WRITE_CLINICAL_SAMPLE"
    tag "module"
    tag "write_clinical_sample"

    test("Merged clinical table — data_clinical_sample.txt is produced") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = Channel.of(
                    tuple('TEST', file('${projectDir}/tests/modules/fixtures/clinical_merged.tsv'))
                )
                """
            }
        }

        then {
            assert process.success
            assert process.out.ch_clinical_sample.size() == 1

            def f = path(process.out.ch_clinical_sample.collect { group, file -> file }[0].toString())
            def lines = f.readLines()

            // 4 '#' metadata header rows, then the column-id row, then data rows.
            assert lines[0].startsWith('#')
            assert lines[3].startsWith('#')
            assert lines[4].split('\t').contains('SAMPLE_ID')
            assert lines.size() > 5

            def cols     = lines[4].split('\t') as List
            def priority = [cols, lines[3].substring(1).split('\t') as List].transpose().collectEntries()
            def rows     = lines.drop(5).collect { [cols, it.split('\t', -1) as List].transpose().collectEntries() }

            // Primary Site is the first study-view chart; every other chart keeps cBioPortal's default.
            assert priority['PRIMARY_SITE'] == '1500'
            assert priority.findAll { k, v -> k != 'PRIMARY_SITE' }.values().every { it == '1' }

            // write_cbio_table() silently drops a col_def whose source column is gone, so pin the labels.
            ['PRIMARY_SITE', 'CANCER_TYPE_LABEL', 'TUMOR_TISSUE_SITE_LABEL'].each { c ->
                assert cols.contains(c)
            }
            def t1 = rows.find { it['PATIENT_ID'] == 'T1' }
            assert t1['PRIMARY_SITE']            == 'Pancreas'
            assert t1['CANCER_TYPE_LABEL']       == 'Pancreas'
            assert t1['TUMOR_TISSUE_SITE_LABEL'] == 'Liver and intrahepatic bile ducts'
        }
    }
}

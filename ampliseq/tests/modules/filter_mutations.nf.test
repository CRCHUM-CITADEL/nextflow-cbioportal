nextflow_process {

    name "Test FILTER_MUTATIONS"
    script "modules/local/filter_mutations/main.nf"
    process "FILTER_MUTATIONS"
    tag "module"
    tag "filter"

    test("Matches TSV regions by column name, with or without chr prefix") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/filter_inputs").mkdirs()
                file("${params.outdir}/filter_inputs/s.maf").text = 'Hugo_Symbol\\tEnd_Position\\tStart_Position\\tChromosome\\n' +
                    'G1\\t150\\t100\\tchr1\\n' +
                    'G2\\t250\\t200\\t2\\n' +
                    'G3\\t350\\t300\\tchr3\\n'
                file("${params.outdir}/filter_inputs/s.tsv").text = 'Chr\\tStart\\tEnd\\tDepth\\tVAF\\n1\\t100\\t150\\t500\\t0.10\\n2\\t200\\t250\\t500\\t0.10\\n'
                input[0] = Channel.of([[sample_id: 'S'], file("${params.outdir}/filter_inputs/s.maf"), file("${params.outdir}/filter_inputs/s.tsv")])
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out[0][0].toString()).readLines()
            assert lines.size() == 3
            assert lines[1].startsWith('G1') && lines[2].startsWith('G2')
        }
    }

    // TSV rows are regions (gene spans, CNV/SV intervals); a mutation is kept when its
    // [Start_Position, End_Position] overlaps one, inclusive, on the same chromosome.
    test("Keeps mutations overlapping a TSV region, drops the rest") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/filter_inputs").mkdirs()
                file("${params.outdir}/filter_inputs/s.maf").text = 'Hugo_Symbol\\tChromosome\\tStart_Position\\tEnd_Position\\n' +
                    'IN_SNV\\tchr17\\t7571720\\t7571720\\n' +     // == region start
                    'MID_SNV\\t17\\t7580000\\t7580000\\n' +       // inside region
                    'END_SNV\\t17\\t7590868\\t7590868\\n' +       // == region end
                    'AFTER\\t17\\t7590869\\t7590869\\n' +         // one past region end
                    'BEFORE\\t17\\t7571719\\t7571719\\n' +        // one before region start
                    'DEL_SPAN\\t12\\t25380270\\t25380280\\n' +    // indel straddling region start
                    'OTHER_CHR\\t5\\t7580000\\t7580000\\n'        // right position, wrong chromosome
                file("${params.outdir}/filter_inputs/s.tsv").text = 'Chr\\tStart\\tEnd\\tVariant Type\\tDepth\\tVAF\\n' +
                    '17\\t7571720\\t7590868\\tSNP\\t500\\t0.10\\n' +
                    '12\\t25380275\\t25403854\\tSNP\\t500\\t0.10\\n'
                input[0] = Channel.of([[sample_id: 'S'], file("${params.outdir}/filter_inputs/s.maf"), file("${params.outdir}/filter_inputs/s.tsv")])
                """
            }
        }

        then {
            assert process.success
            def kept = path(process.out[0][0].toString()).readLines().drop(1).collect { it.split('\t')[0] }
            assert kept == ['IN_SNV', 'MID_SNV', 'END_SNV', 'DEL_SPAN']
        }
    }

    test("Header-only TSV keeps only the MAF header") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/filter_inputs").mkdirs()
                file("${params.outdir}/filter_inputs/s.maf").text = 'Hugo_Symbol\\tChromosome\\tStart_Position\\tEnd_Position\\n' +
                    'G1\\t1\\t100\\t100\\n'
                file("${params.outdir}/filter_inputs/s.tsv").text = 'Chr\\tStart\\tEnd\\tDepth\\tVAF\\n'
                input[0] = Channel.of([[sample_id: 'S'], file("${params.outdir}/filter_inputs/s.maf"), file("${params.outdir}/filter_inputs/s.tsv")])
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out[0][0].toString()).readLines()
            assert lines == ['Hugo_Symbol\tChromosome\tStart_Position\tEnd_Position']
        }
    }

    // N/A Depth/VAF rows (CNV/fusion) must not act as match regions
    test("Keeps only mutations matching a TSV row with Depth >= 250 and VAF > 0.03") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/filter_inputs").mkdirs()
                file("${params.outdir}/filter_inputs/s.maf").text = 'Hugo_Symbol\\tChromosome\\tStart_Position\\tEnd_Position\\n' +
                    'DEPTH_249\\tchr1\\t100\\t100\\n' +
                    'DEPTH_250\\tchr1\\t200\\t200\\n' +
                    'VAF_0.03\\tchr1\\t300\\t300\\n' +
                    'VAF_0.031\\tchr1\\t400\\t400\\n' +
                    'IN_FUSION\\tchr6\\t120000000\\t120000000\\n' +
                    'IN_CNV\\tchr4\\t550000\\t550000\\n'
                file("${params.outdir}/filter_inputs/s.tsv").text =
                    'Chr\\tStart\\tEnd\\tVariant Type\\tVariant Subtype\\tVAF\\tConfidence\\tDepth\\tCopy Number\\n' +
                    '1\\t100\\t100\\tSNP\\tSNP\\t0.20\\tHIGH\\t249\\tN/A\\n' +
                    '1\\t200\\t200\\tSNP\\tSNP\\t0.20\\tHIGH\\t250\\tN/A\\n' +
                    '1\\t300\\t300\\tSNP\\tSNP\\t0.03\\tHIGH\\t1000\\tN/A\\n' +
                    '1\\t400\\t400\\tSNP\\tINDEL\\t0.031\\tLOW\\t1000\\tN/A\\n' +
                    '6\\t117710982\\t149784294\\tCNV\\tFUSION\\tN/A\\tMEDIUM\\tN/A\\tN/A\\n' +
                    '4\\t500000\\t600000\\tCNV\\tDUPLICATION\\tN/A\\tHIGH\\tN/A\\t8\\n'
                input[0] = Channel.of([[sample_id: 'S'], file("${params.outdir}/filter_inputs/s.maf"), file("${params.outdir}/filter_inputs/s.tsv")])
                """
            }
        }

        then {
            assert process.success
            def kept = path(process.out[0][0].toString()).readLines().drop(1).collect { it.split('\t')[0] }
            assert kept == ['DEPTH_250', 'VAF_0.031']
        }
    }

    test("Fails when the TSV has no Depth column") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                file("${params.outdir}/filter_inputs").mkdirs()
                file("${params.outdir}/filter_inputs/s.maf").text = 'Hugo_Symbol\\tChromosome\\tStart_Position\\tEnd_Position\\n' +
                    'G1\\t1\\t100\\t100\\n'
                file("${params.outdir}/filter_inputs/s.tsv").text = 'Chr\\tStart\\tEnd\\tVAF\\n1\\t100\\t100\\t0.5\\n'
                input[0] = Channel.of([[sample_id: 'S'], file("${params.outdir}/filter_inputs/s.maf"), file("${params.outdir}/filter_inputs/s.tsv")])
                """
            }
        }

        then {
            assert process.failed
            assert workflow.stdout.any { it.contains('lacks one of Chr/Start/End/Depth/VAF') }
        }
    }
}

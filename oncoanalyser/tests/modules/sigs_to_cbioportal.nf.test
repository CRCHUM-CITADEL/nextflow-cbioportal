nextflow_process {

    name "Test SIGS_TO_CBIOPORTAL module"
    script "modules/local/sigs_to_cbioportal/main.nf"
    process "SIGS_TO_CBIOPORTAL"
    tag "module"
    tag "sigs"

    test("Two subjects — data_sigs.txt files are produced") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1', pipeline: 'sigs'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/sigs/T1-T.sig.allocation.tsv')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2', pipeline: 'sigs'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T2/sigs/T2-T.sig.allocation.tsv')
                    ]
                )
                """
            }
        }

        then {
            assert process.success
            assert process.out.sigs.size() == 2

            def names = process.out.sigs.collect { meta, f -> f.toString().split('/').last() }.sort()
            assert names == ['T1.data_sigs.txt', 'T2.data_sigs.txt']

            // Verify cBioPortal GENERIC_ASSAY format columns
            def t1_path = process.out.sigs.collect { meta, f -> f }.find { it.toString().endsWith('T1.data_sigs.txt') }
            def header = path(t1_path.toString()).readLines()[0]
            assert header.contains('ENTITY_STABLE_ID')
            assert header.contains('NAME')
            assert header.contains('DESCRIPTION')
            assert header.contains('T1')

            // Verify signature rows are present
            def t1_lines = path(t1_path.toString()).readLines()
            assert t1_lines.size() > 1
            def sig_ids = t1_lines[1..-1].collect { it.split('\t')[0] }
            assert sig_ids.contains('SBS1')
            assert sig_ids.contains('SBS5')

            snapshot(
                process.out.sigs.collect { meta, f -> path(f.toString()) }.sort { it.toString().split('/').last() }
            ).match()
        }
    }
}

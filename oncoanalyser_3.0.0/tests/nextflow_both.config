/*
========================================================================================
    Nextflow config file for running nf-test tests in "both" mode
========================================================================================
*/

params {

    config_profile_name        = 'Both mode test profile'
    config_profile_description = 'Test dataset to check combined genomic + clinical pipeline'

    // Input data
    mode                        = "both"
    study_id                    = "TEST"
    input_dir                   = "${projectDir}"
    genomic_samplesheet         = "${projectDir}/assets/test_data/samplesheet/test_genomic_2.csv"
    ensembl_annotations         = "${projectDir}/assets/test_data/annotations/biomart_grch38_ensembl_113_test.tsv"
    genome_reference            = "${projectDir}/assets/test_data/reference/Homo_sapiens_assembly38_chr21.fasta"
    // Existing dirs so no download runs; never read (stand-in cpsr, mafsmith --skip-annotation).
    // PCGR stages vep_data and pcgr_data together, so their basenames must differ.
    vep_data                    = "${projectDir}/assets/test_data/annotations"
    pcgr_data                   = "${projectDir}/assets/test_data/reference"
    mafsmith_data               = "${projectDir}/assets/test_data/clinical"
    cosmic_data                 = ""
    chimer_data                 = ""

    container_r                 = "oras://ghcr.io/crchum-citadel/sdp-r:4.5.1"
    container_python            = "oras://ghcr.io/crchum-citadel/sdp-python:3.12"
    container_pcgr              = "oras://ghcr.io/sigven/pcgr:2.4.0.singularity"
    container_mafsmith          = "oras://ghcr.io/crchum-citadel/mafsmith-fastvep:0.1.0-0.4.0"

    // clinical params:
    clinical_samplesheet        = "${projectDir}/assets/test_data/samplesheet/test_clinical.csv"
    sample_registrations        = ""
}


// Every task runs for real except two tools: CPSR is the stand-in in tests/modules/fixtures/fake_cpsr
// (emitting a real-format CPSR table), run in the bcftools image, and mafsmith skips fastVEP annotation.
process {
    withName: 'PCGR' {
        container    = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/47/474a5ea8dc03366b04df884d89aeacc4f8e6d1ad92266888e7a8e7958d07cde8/data'
        // Nextflow starts the container with a clean env, so pass the stand-in's PATH and table via apptainer.
        containerOptions = "-B ${projectDir}/tests/modules/fixtures --env PREPEND_PATH=${projectDir}/tests/modules/fixtures/fake_cpsr --env FAKE_CPSR_TSV=${projectDir}/tests/modules/fixtures/cpsr_germline.tsv.gz"
    }
    withName: 'MAFSMITH' {
        ext.args     = '--skip-annotation'
    }
    memory = 1.GB
    withLabel:process_single       { memory = 1.GB }
    withLabel:process_low          { memory = 1.GB }
    withLabel:process_medium       { memory = 1.GB }
    withLabel:process_medium_memory { memory = 1.GB }
    withLabel:process_high         { memory = 1.GB }
    withLabel:process_high_memory  { memory = 1.GB }
}

profiles {
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
    }
}

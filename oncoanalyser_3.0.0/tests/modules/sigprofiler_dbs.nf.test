nextflow_process {

    name "Test SIGPROFILER_DBS module"
    script "modules/local/sigprofiler_dbs/main.nf"
    process "SIGPROFILER_DBS"
    tag "module"
    tag "sigs"

    test("Two subjects — DBS contribution and counts files are produced") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1', pipeline: 'sigs_dbs'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/pave/somatic/T1-T.pave.somatic.vcf.gz')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2', pipeline: 'sigs_dbs'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T2/pave/somatic/T2-T.pave.somatic.vcf.gz')
                    ]
                )
                input[1] = file('${projectDir}/assets/COSMIC_Human_v3.6.zip')
                input[2] = file('${projectDir}/assets/cosmic_dbs_metadata.tsv')
                """
            }
        }

        then {
            assert process.success

            // Contribution files
            assert process.out.sigs_dbs.size() == 2
            def contrib_names = process.out.sigs_dbs.collect { meta, f -> f.toString().split('/').last() }.sort()
            assert contrib_names == ['T1.data_mutational_signatures_contribution_DBS.txt', 'T2.data_mutational_signatures_contribution_DBS.txt']

            // Counts files
            assert process.out.sigs_counts_dbs.size() == 2
            def counts_names = process.out.sigs_counts_dbs.collect { meta, f -> f.toString().split('/').last() }.sort()
            assert counts_names == ['T1.data_mutational_signatures_counts_DBS.txt', 'T2.data_mutational_signatures_counts_DBS.txt']

            // Verify contribution format
            def t1_contrib = process.out.sigs_dbs.collect { meta, f -> f }.find { it.toString().endsWith('T1.data_mutational_signatures_contribution_DBS.txt') }
            def contrib_header = path(t1_contrib.toString()).readLines()[0]
            assert contrib_header.contains('ENTITY_STABLE_ID')
            assert contrib_header.contains('NAME')
            assert contrib_header.contains('DESCRIPTION')
            assert contrib_header.contains('T1')

            // Verify counts format (no CATEGORY, no DESCRIPTION)
            def t1_counts = process.out.sigs_counts_dbs.collect { meta, f -> f }.find { it.toString().endsWith('T1.data_mutational_signatures_counts_DBS.txt') }
            def counts_header = path(t1_counts.toString()).readLines()[0]
            assert counts_header.contains('ENTITY_STABLE_ID')
            assert counts_header.contains('NAME')
            assert !counts_header.contains('CATEGORY')
            assert !counts_header.contains('DESCRIPTION')
            assert counts_header.contains('T1')

            // Verify counts ENTITY_STABLE_ID uses ref-alt format (e.g. mutational_signatures_matrix_AC-CA)
            def counts_lines = path(t1_counts.toString()).readLines()
            assert counts_lines.size() > 1
            def counts_ids = counts_lines[1..-1].collect { it.split('\t')[0] }
            assert counts_ids.any { it.startsWith('mutational_signatures_matrix_') }
            assert counts_ids.every { !it.contains('DBS_') }

            snapshot(
                process.out.sigs_dbs.collect { meta, f -> path(f.toString()) }.sort { it.toString().split('/').last() },
                process.out.sigs_counts_dbs.collect { meta, f -> path(f.toString()) }.sort { it.toString().split('/').last() }
            ).match()
        }
    }
}

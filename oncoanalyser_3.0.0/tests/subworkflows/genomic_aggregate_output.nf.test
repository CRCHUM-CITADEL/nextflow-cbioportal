nextflow_workflow {

    name "Test GENOMIC_AGGREGATE_OUTPUT subworkflow"
    script "subworkflows/local/genomic_aggregate_output/main.nf"
    workflow "GENOMIC_AGGREGATE_OUTPUT"
    tag "subworkflow"
    tag "genomic_aggregate"

    test("Two subjects — group-level merged files, case lists, and meta files produced") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                // collectFile with storeDir does not create subdirectories (publishDir does in the pipeline)
                file("${params.outdir}/TEST").mkdirs()

                // SEG files (one per subject) — collectFile merges them into group-level data_cna_hg38.seg
                input[0] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1_data_cna_hg38.seg')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2_data_cna_hg38.seg')
                    ]
                )
                // CNA long files — merges into data_cna_long.txt
                input[1] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1_data_cna_long.txt')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2_data_cna_long.txt')
                    ]
                )
                // SV files — merges into data_sv.txt
                input[2] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.data_sv.txt')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2.data_sv.txt')
                    ]
                )
                // TPM files — MERGE_EXPRESSION_FILES_TO_CBIOPORTAL requires >= 2 files per group
                input[3] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.tpm.tsv')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2.tpm.tsv')
                    ]
                )
                // MAF files — collectFile with skip:2 merges (skips #version + header on all but first)
                input[4] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.somatic_rna_germline.maf')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2.somatic_rna_germline.maf')
                    ]
                )
                // Sigs and sigs_counts — empty channels (optional; not all runs produce signatures)
                input[5] = Channel.empty()   // sigs_results (SBS contribution)
                input[6] = Channel.empty()   // sigs_counts_results (SBS counts)
                input[7] = Channel.empty()   // sigs_dbs_results (DBS contribution)
                input[8] = Channel.empty()   // sigs_counts_dbs_results (DBS counts)
                input[9] = Channel.empty()   // sigs_id_results (ID contribution)
                input[10] = Channel.empty()  // sigs_counts_id_results (ID counts)
                // Genomic sample attributes (TMB/HRD) — collectFile with skip:5 keeps one header
                input[11] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.genomic_sample_attributes.tsv')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2.genomic_sample_attributes.tsv')
                    ]
                )
                """
            }
        }

        then {
            assert workflow.success

            // Group-level merged genomic files
            assert path("${params.outdir}/TEST/data_cna_hg38.seg").exists()
            assert path("${params.outdir}/TEST/data_sv.txt").exists()
            assert path("${params.outdir}/TEST/data_cna_long.txt").exists()
            assert path("${params.outdir}/TEST/data_mutations_dna_rna_germline.txt").exists()
            assert path("${params.outdir}/TEST/data_expression.txt").exists()

            // Case lists: every standard list for the profiles present; _all comes from add_global_case_list
            def case_dir = "${params.outdir}/TEST/case_lists"
            ['sequenced', 'cna', 'cnaseq', 'sv', 'rna_seq_v2_mrna', '3way_complete'].each { s ->
                assert path("${case_dir}/cases_${s}.txt").exists() : "missing cases_${s}.txt"
            }
            assert !path("${case_dir}/cases_cnv.txt").exists()
            assert !path("${case_dir}/cases_all.txt").exists()

            // Meta files
            assert path("${params.outdir}/TEST/meta_cna_hg38.txt").exists()
            assert path("${params.outdir}/TEST/meta_cna_long.txt").exists()
            assert path("${params.outdir}/TEST/meta_sv.txt").exists()
            // cBioPortal imports the HMF.PURPLE_* SV columns only when the namespace is declared
            assert path("${params.outdir}/TEST/meta_sv.txt").readLines().contains('namespaces: HMF')
            def sv_header = path("${params.outdir}/TEST/data_sv.txt").readLines()[0].split('\t') as List
            assert sv_header.contains('HMF.PURPLE_JCN')
            assert path("${params.outdir}/TEST/data_sv.txt").readLines().every { it.split('\t', -1).size() == sv_header.size() }
            assert path("${params.outdir}/TEST/meta_expression.txt").exists()
            assert path("${params.outdir}/TEST/meta_sequenced.txt").exists()

            // Verify SEG merge: both samples present
            def seg_lines = path("${params.outdir}/TEST/data_cna_hg38.seg").readLines()
            assert seg_lines.any { it.startsWith('T1') }
            assert seg_lines.any { it.startsWith('T2') }

            // Sample attributes: 4 # lines + ID line, then a row per sample (an intermediate, not a study file)
            assert workflow.out.sample_attributes.size() == 1
            assert workflow.out.sample_attributes[0][0] == 'TEST'
            def attrs = path(workflow.out.sample_attributes[0][1].toString()).readLines()
            assert attrs.take(4).every { it.startsWith('#') }
            assert attrs[4] == 'PATIENT_ID\tSAMPLE_ID\tTMB_PER_MB\tTMB_STATUS\tTML\tTML_STATUS\tHRD_SCORE\tHR_STATUS\tHRD_TYPE'
            assert attrs.drop(5).sort() == [  // sort: 'deep' orders by content, not sample
                'T1\tT1\t12.5\tHIGH\t312\tHIGH\t0.83\tHR_deficient\tBRCA2_type',
                'T2\tT2\t2.1\tLOW\t45\tLOW\tNA\tNA\tNA',
            ]
            assert !path("${params.outdir}/TEST/data_clinical_sample.txt").exists()
            assert !path("${params.outdir}/TEST/meta_clinical_sample.txt").exists()

            // Case list format: all fields, standard stable_id suffix, valid category, tab-separated IDs
            assert path("${case_dir}/cases_cna.txt").readLines() == [
                'cancer_study_identifier: test',
                'stable_id: test_cna',
                'case_list_name: Samples with CNA data',
                'case_list_description: Samples profiled for copy-number alterations',
                'case_list_category: all_cases_with_cna_data',
                'case_list_ids: T1\tT2',
            ]
            def categories = new File(case_dir).listFiles().collect { f ->
                def lines = f.readLines()
                assert !lines.any { it.contains('add_text') || it.contains('ADD TEXT') } : f.name
                lines.find { it.startsWith('case_list_category: ') }
            }
            assert categories.size() == categories.toSet().size()  // the validator warns on a reused category
        }
    }

    test("mode=genomic-dna-only — no expression data or meta file produced, even with TPM input supplied") {

        when {
            params {
                outdir = "$outputDir"
                mode   = 'genomic-dna-only'
            }
            workflow {
                """
                file("${params.outdir}/TEST").mkdirs()

                input[0] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1_data_cna_hg38.seg')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2_data_cna_hg38.seg')
                    ]
                )
                input[1] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1_data_cna_long.txt')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2_data_cna_long.txt')
                    ]
                )
                input[2] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.data_sv.txt')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2.data_sv.txt')
                    ]
                )
                // TPM supplied on purpose: dna-only must still omit expression output
                input[3] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.tpm.tsv')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2.tpm.tsv')
                    ]
                )
                input[4] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.somatic_rna_germline.maf')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2.somatic_rna_germline.maf')
                    ]
                )
                input[5] = Channel.empty()
                input[6] = Channel.empty()
                input[7] = Channel.empty()
                input[8] = Channel.empty()
                input[9] = Channel.empty()
                input[10] = Channel.empty()
                input[11] = Channel.empty()  // sample_attributes
                """
            }
        }

        then {
            assert workflow.success

            // Non-expression outputs still produced as normal
            assert path("${params.outdir}/TEST/data_cna_hg38.seg").exists()
            assert path("${params.outdir}/TEST/data_sv.txt").exists()
            assert path("${params.outdir}/TEST/data_cna_long.txt").exists()
            assert path("${params.outdir}/TEST/data_mutations_dna_rna_germline.txt").exists()
            assert path("${params.outdir}/TEST/meta_cna_hg38.txt").exists()
            assert path("${params.outdir}/TEST/meta_sv.txt").exists()

            // No expression data file and no orphan expression meta file
            assert !path("${params.outdir}/TEST/data_expression.txt").exists()
            assert !path("${params.outdir}/TEST/meta_expression.txt").exists()

            // DNA case lists only: no mRNA lists without expression data
            ['sequenced', 'cna', 'cnaseq', 'sv'].each { s ->
                assert path("${params.outdir}/TEST/case_lists/cases_${s}.txt").exists()
            }
            assert !path("${params.outdir}/TEST/case_lists/cases_rna_seq_v2_mrna.txt").exists()
            assert !path("${params.outdir}/TEST/case_lists/cases_3way_complete.txt").exists()
        }
    }

    test("mode=genomic-dna-only — tools not run (no SV VCF, no sigs) leave no orphan meta files or case lists") {

        when {
            params {
                outdir = "$outputDir"
                mode   = 'genomic-dna-only'
            }
            workflow {
                """
                file("${params.outdir}/TEST").mkdirs()

                input[0] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1-1DT'],
                        file('${projectDir}/assets/test_data/precomputed/T1-1DT_data_cna_hg38.seg')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2-T'],
                        file('${projectDir}/assets/test_data/precomputed/T2-T_data_cna_hg38.seg')
                    ]
                )
                input[1] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1-1DT'],
                        file('${projectDir}/assets/test_data/precomputed/T1-1DT_data_cna_long.txt')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2-T'],
                        file('${projectDir}/assets/test_data/precomputed/T2-T_data_cna_long.txt')
                    ]
                )
                input[2] = Channel.empty()   // no PURPLE SV VCF → no SV
                input[3] = Channel.empty()   // dna-only → no expression
                input[4] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1-1DT'],
                        file('${projectDir}/assets/test_data/precomputed/T1-1DT.somatic_rna_germline.maf')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2-T'],
                        file('${projectDir}/assets/test_data/precomputed/T2-T.somatic_rna_germline.maf')
                    ]
                )
                input[5] = Channel.empty()   // no sigs/ → no SBS contribution
                input[6] = Channel.empty()   // no sigs/ → no SBS counts
                input[7] = Channel.empty()
                input[8] = Channel.empty()
                input[9] = Channel.empty()
                input[10] = Channel.empty()
                input[11] = Channel.empty()  // sample_attributes
                """
            }
        }

        then {
            assert workflow.success

            // Data types with output: data, meta and case list present
            assert path("${params.outdir}/TEST/data_cna_hg38.seg").exists()
            assert path("${params.outdir}/TEST/data_mutations_dna_rna_germline.txt").exists()
            assert path("${params.outdir}/TEST/meta_cna_hg38.txt").exists()
            assert path("${params.outdir}/TEST/meta_cna_long.txt").exists()
            assert path("${params.outdir}/TEST/meta_sequenced.txt").exists()
            assert path("${params.outdir}/TEST/case_lists/cases_cna.txt").exists()
            assert path("${params.outdir}/TEST/case_lists/cases_sequenced.txt").exists()
            assert path("${params.outdir}/TEST/case_lists/cases_cnaseq.txt").exists()

            // Case lists keep their own samples when another data type is empty
            def seq_ids = path("${params.outdir}/TEST/case_lists/cases_sequenced.txt").readLines()
                .find { it.startsWith('case_list_ids:') }
            assert seq_ids.contains('T1-1DT') && seq_ids.contains('T2-T')
            def seq_stable = path("${params.outdir}/TEST/case_lists/cases_sequenced.txt").readLines()
                .find { it.startsWith('stable_id:') }
            assert seq_stable.endsWith('_sequenced')

            // SV not run: no data, meta or case list
            assert !path("${params.outdir}/TEST/data_sv.txt").exists()
            assert !path("${params.outdir}/TEST/meta_sv.txt").exists()
            assert !path("${params.outdir}/TEST/case_lists/cases_sv.txt").exists()

            // Signatures not run: no orphan meta files
            ['contribution', 'counts'].each { kind ->
                ['SBS', 'DBS', 'ID'].each { sig ->
                    assert !path("${params.outdir}/TEST/meta_mutational_signatures_${kind}_${sig}.txt").exists()
                }
            }
            assert !path("${params.outdir}/TEST/meta_expression.txt").exists()
        }
    }

    test("Case lists — combined lists hold only samples with every profile; empty lists are not written") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                file("${params.outdir}/TEST").mkdirs()

                input[0] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1_data_cna_hg38.seg')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2_data_cna_hg38.seg')
                    ]
                )
                input[1] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1_data_cna_long.txt')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2_data_cna_long.txt')
                    ]
                )
                input[2] = Channel.empty()   // no SV
                input[3] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.tpm.tsv')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2.tpm.tsv')
                    ]
                )
                input[4] = Channel.of(  // T2 has no MAF
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.somatic_rna_germline.maf')
                    ]
                )
                input[5] = Channel.empty()
                input[6] = Channel.empty()
                input[7] = Channel.empty()
                input[8] = Channel.empty()
                input[9] = Channel.empty()
                input[10] = Channel.empty()
                input[11] = Channel.empty()
                """
            }
        }

        then {
            assert workflow.success
            def ids = { s ->
                def f = path("${params.outdir}/TEST/case_lists/cases_${s}.txt")
                f.exists() ? f.readLines().find { it.startsWith('case_list_ids: ') }.substring(15).split('\t') as List : null
            }
            assert ids('sequenced') == ['T1']
            assert ids('cna') == ['T1', 'T2']
            assert ids('cnaseq') == ['T1']                // mutation ∩ CNA
            assert ids('rna_seq_v2_mrna') == ['T1', 'T2']
            assert ids('3way_complete') == ['T1']         // mutation ∩ CNA ∩ mRNA
            assert ids('sv') == null                      // no SV output → no (empty) list
        }
    }

    test("Case lists — no mRNA lists when the expression merge is skipped (< 2 TPM files)") {

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                file("${params.outdir}/TEST").mkdirs()

                input[0] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1_data_cna_hg38.seg')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2_data_cna_hg38.seg')
                    ]
                )
                input[1] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1_data_cna_long.txt')
                    ],
                    [
                        [group: 'TEST', subject: 'T2', sample: 'T2'],
                        file('${projectDir}/assets/test_data/precomputed/T2_data_cna_long.txt')
                    ]
                )
                input[2] = Channel.empty()   // no SV
                input[3] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.tpm.tsv')
                    ]
                )
                input[4] = Channel.of(  // T2 has no MAF
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1'],
                        file('${projectDir}/assets/test_data/precomputed/T1.somatic_rna_germline.maf')
                    ]
                )
                input[5] = Channel.empty()
                input[6] = Channel.empty()
                input[7] = Channel.empty()
                input[8] = Channel.empty()
                input[9] = Channel.empty()
                input[10] = Channel.empty()
                input[11] = Channel.empty()
                """
            }
        }

        then {
            assert workflow.success
            def ids = { s ->
                def f = path("${params.outdir}/TEST/case_lists/cases_${s}.txt")
                f.exists() ? f.readLines().find { it.startsWith('case_list_ids: ') }.substring(15).split('\t') as List : null
            }
            // one TPM file is not merged, so no sample is in data_expression.txt
            assert !path("${params.outdir}/TEST/data_expression.txt").exists()
            assert ids('rna_seq_v2_mrna') == null
            assert ids('3way_complete') == null
            assert ids('cnaseq') == ['T1']
        }
    }
}

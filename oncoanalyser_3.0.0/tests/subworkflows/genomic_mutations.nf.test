nextflow_workflow {

    name "Test GENOMIC_MUTATIONS subworkflow"
    script "subworkflows/local/genomic_mutations/main.nf"
    workflow "GENOMIC_MUTATIONS"
    tag "subworkflow"
    tag "genomic_mutations"

    // Runs under -stub-run. MAFSMITH needs its pre-fetched reference bundle
    // (params.mafsmith_data), which is a site path with no public download, so the
    // real mutation path cannot execute in CI. What is asserted here is the wiring:
    // germline VCF -> FILTER_GERMLINE_DNA -> BCFTOOLS_INDEX -> PCGR, somatic VCF ->
    // MAFSMITH -> INTEGRATE_RNA_VARIANTS -> CONVERT_CPSR_TO_MAF, joined on subject.
    options "-stub-run"

    test("One subject — somatic+germline MAF is produced") {

        config "tests/nextflow_mutations.config"

        when {
            params {
                outdir    = "$outputDir"
                vep_data  = "${projectDir}/assets/test_data/annotations"
                pcgr_data = "${projectDir}/assets/test_data/reference"
            }
            workflow {
                """
                // Germline VCF (contains both normal T1-N and tumor T1 sample columns)
                input[0] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1', pipeline: 'mutation_germline'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/pave/germline/T1-T.pave.germline.vcf.gz')
                    ]
                )
                // Somatic VCF
                input[1] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1', pipeline: 'mutation'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/pave/somatic/T1-T.pave.somatic.vcf.gz')
                    ]
                )
                // RNA-append VCF
                input[2] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1', pipeline: 'mutation_rna'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/sage_append/T1-T/T1-T.sage.append.vcf.gz')
                    ]
                )
                // vep_data / pcgr_data — directories that exist, so needs_* stay false
                // and no download process is reachable. Their content is never read
                // under -stub-run, but the basenames must differ: PCGR stages both at
                // once and two inputs named "annotations" is a staging collision.
                input[3] = Channel.of(file('${projectDir}/assets/test_data/annotations'))
                input[4] = Channel.of(file('${projectDir}/assets/test_data/reference'))
                // mafsmith home — stubbed, so only its presence matters
                input[5] = Channel.of(file('${projectDir}/assets/test_data/clinical'))
                // needs_vep / needs_pcgr / needs_mafsmith
                input[6] = false
                input[7] = false
                input[8] = false
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.out.size() == 1

            // The subject survives every join in the chain and comes out named for its sample.
            def maf_path = workflow.out.out.collect { meta, f -> f }[0].toString()
            assert maf_path.endsWith('.maf')

            // Every process on the mutation path actually ran.
            def ran = workflow.trace.succeeded().collect { it.name }
            ['FILTER_GERMLINE_DNA', 'BCFTOOLS_INDEX', 'PCGR', 'MAFSMITH',
             'INTEGRATE_RNA_VARIANTS', 'CONVERT_CPSR_TO_MAF'].each { proc ->
                assert ran.any { it.contains(proc) } : "${proc} did not run: ${ran}"
            }
            // No download process is reachable when the reference data is pre-staged.
            assert !ran.any {
                it.contains('DOWNLOAD_VEP_TEST') || it.contains('DOWNLOAD_PCGR') || it.contains('DOWNLOAD_MAFSMITH')
            }
        }
    }

    test("No pre-staged reference data — the download fallbacks run instead") {

        config "tests/nextflow_mutations.config"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1', pipeline: 'mutation_germline'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/pave/germline/T1-T.pave.germline.vcf.gz')
                    ]
                )
                input[1] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1', pipeline: 'mutation'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/pave/somatic/T1-T.pave.somatic.vcf.gz')
                    ]
                )
                input[2] = Channel.of(
                    [
                        [group: 'TEST', subject: 'T1', sample: 'T1', pipeline: 'mutation_rna'],
                        file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/sage_append/T1-T/T1-T.sage.append.vcf.gz')
                    ]
                )
                // Nothing pre-staged: the three needs_* flags select the download modules.
                // Their stubs make empty directories, so nothing is actually fetched here.
                input[3] = Channel.empty()
                input[4] = Channel.empty()
                input[5] = Channel.empty()
                input[6] = true
                input[7] = true
                input[8] = true
                """
            }
        }

        then {
            assert workflow.success
            assert workflow.out.out.size() == 1

            // The download modules publish with storeDir, so a directory left by an
            // earlier run satisfies them without the process executing again. Assert on
            // the directory each one is responsible for, which holds either way, rather
            // than on the trace — under -stub-run these are the stubs' empty dirs.
            ['vep', 'pcgr', 'mafsmith'].each { name ->
                assert file("${projectDir}/assets/${name}").exists() : "assets/${name} was not provisioned"
            }

            // MAFSMITH still runs, fed by the fallback rather than a pre-staged bundle.
            def ran = workflow.trace.succeeded().collect { it.name }
            assert ran.any { it.contains('MAFSMITH') && !it.contains('DOWNLOAD') } : "MAFSMITH did not run: ${ran}"
        }
    }
}

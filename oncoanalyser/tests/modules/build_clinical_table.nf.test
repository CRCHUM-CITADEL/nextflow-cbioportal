nextflow_process {

    name "Test BUILD_CLINICAL_TABLE module"
    script "modules/local/build_clinical_table/main.nf"
    process "BUILD_CLINICAL_TABLE"
    tag "module"
    tag "build_clinical_table"

    test("All ARGO CSVs — merged clinical table is produced") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        [group: 'TEST'],
                        file('${projectDir}/assets/test_data/clinical/donors.csv'),
                        file('${projectDir}/assets/test_data/clinical/primary_diagnoses.csv'),
                        file('${projectDir}/assets/test_data/clinical/specimens.csv'),
                        file('${projectDir}/assets/test_data/clinical/sample_registrations.csv'),
                        file('${projectDir}/assets/test_data/clinical/treatments.csv'),
                        file('${projectDir}/assets/test_data/clinical/surgeries.csv'),
                        file('${projectDir}/assets/test_data/clinical/systemic_therapies.csv'),
                        file('${projectDir}/assets/test_data/clinical/radiations.csv'),
                        file('${projectDir}/assets/test_data/clinical/follow_ups.csv'),
                        file('${projectDir}/assets/test_data/clinical/biomarkers.csv'),
                        [],
                        file('${projectDir}/assets/mohccn_clinical_data_modelv3-1_sep2024_primary_site.csv'),
                        file('${projectDir}/assets/mohccn_clinical_data_modelv3-1_sep2024_specimen_tissue_source.csv'),
                        file('${projectDir}/assets/mohccn_clinical_data_modelv3-1_sep2024_treatment_intent.csv')
                    )
                )
                input[1] = file('${projectDir}/bin/clinical_common.R')
                """
            }
        }

        then {
            assert process.success
            assert process.out.ch_merged.size() == 1

            def merged = path(process.out.ch_merged.collect { group, f -> f }[0].toString())
            def lines  = merged.readLines()
            def cols   = lines[0].split('\t') as List

            // Two eligible sequenced tumours (T1, T2) in the fixture set — see
            // tests/subworkflows/clinical_aggregate.nf.test for the full eligibility
            // and merge-cascade assertions this table feeds.
            assert lines.size() == 3

            // Fields consumed by both writers must be present.
            assert cols.contains('patient')
            assert cols.contains('sample')
            assert cols.contains('age')
            assert cols.contains('os_status')
            assert cols.contains('primary_site_code')
            assert cols.contains('relapse_site_label')
        }
    }
}

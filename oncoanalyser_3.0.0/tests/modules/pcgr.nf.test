nextflow_process {

    name "Test PCGR module"
    script "modules/local/pcgr/main.nf"
    process "PCGR"
    config "tests/nextflow_pcgr.config"
    tag "module"
    tag "pcgr"

    test("PAVE INFO tags are stripped; CPSR's normal-named output is published under the tumour sample name") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [group: 'TEST', subject: 'T1', sample: 'T1-T'],
                    file('${projectDir}/tests/modules/fixtures/pave_germline_impact.vcf.gz'),
                    file('${projectDir}/tests/modules/fixtures/pave_germline_impact.vcf.gz.tbi')
                ])
                input[1] = file('${projectDir}/assets/test_data/annotations')
                input[2] = file('${projectDir}/assets/test_data/reference')
                """
            }
        }

        then {
            assert process.success
            def out = process.out[0][0][1].toString()
            assert out.endsWith('T1-T.cpsr.grch38.classification.tsv.gz')
            // The real calls, not the header-only placeholder.
            assert path(out).linesGzip.size() == 2

            // Debug folder: CPSR's log, what it was given, and its other outputs.
            def debug = process.out.debug[0][1].toString()
            assert debug.endsWith('T1-T.cpsr_debug')
            // CPSR 2.4: no PDF report, and ClinVar calls for non-cancer phenotypes excluded.
            assert path("${debug}/cpsr.log").text.contains('fake cpsr: sample_id=T1-N no_pdf=1 clinvar_cancer_only=1')
            def summary = path("${debug}/input_summary.txt").text
            // Only the normal (first column) reaches CPSR; the tumour column T1 is dropped
            assert summary.readLines().find { it.startsWith('samples:') }.trim() == 'samples: T1-N'
            assert summary.contains('-- GT per sample')
            assert summary.contains('## after CPSR validation')
            assert path("${debug}/T1-N.cpsr.grch38.pass.vcf.gz").exists()
        }
    }

    // Inputs: the T1 germline VCF with samples reordered/renamed (bcftools view -s / reheader -s), committed as fixtures

    test("tumour column first — CPSR still gets the normal, found by name") {


        when {
            process {
                """
                input[0] = Channel.of([
                    [group: 'TEST', subject: 'T1', sample: 'T1-T'],
                    file('${projectDir}/tests/modules/fixtures/purple_germline_tumour_first.vcf.gz'),
                    file('${projectDir}/tests/modules/fixtures/purple_germline_tumour_first.vcf.gz.tbi')
                ])
                input[1] = file('${projectDir}/assets/test_data/annotations')
                input[2] = file('${projectDir}/assets/test_data/reference')
                """
            }
        }

        then {
            assert process.success
            def summary = path("${process.out.debug[0][1]}/input_summary.txt").text
            assert summary.readLines().find { it.startsWith('samples:') }.trim() == 'samples: T1-N'
        }
    }

    test("no <subject>-N column — the task fails instead of guessing") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [group: 'TEST', subject: 'T9', sample: 'T9-T'],
                    file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/purple/T1-T.purple.germline.vcf.gz'),
                    file('${projectDir}/assets/test_data/oncoanalyser_output/TEST/T1/purple/T1-T.purple.germline.vcf.gz.tbi')
                ])
                input[1] = file('${projectDir}/assets/test_data/annotations')
                input[2] = file('${projectDir}/assets/test_data/reference')
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('has no sample column T9-N')
        }
    }

    test("CPSR finds nothing — a header-only placeholder, and the task still succeeds") {


        when {
            process {
                """
                input[0] = Channel.of([
                    [group: 'TEST', subject: 'EMPTY', sample: 'EMPTY-T'],
                    file('${projectDir}/tests/modules/fixtures/purple_germline_empty.vcf.gz'),
                    file('${projectDir}/tests/modules/fixtures/purple_germline_empty.vcf.gz.tbi')
                ])
                input[1] = file('${projectDir}/assets/test_data/annotations')
                input[2] = file('${projectDir}/assets/test_data/reference')
                """
            }
        }

        then {
            assert process.success
            def out = process.out[0][0][1].toString()
            assert out.endsWith('EMPTY-T.cpsr.grch38.classification.tsv.gz')
            assert path(out).linesGzip.size() == 1
            assert path("${process.out.debug[0][1]}/cpsr.log").text.contains('header-only placeholder used')
        }
    }

    test("CPSR logs an ERROR but exits 0 — the task fails instead of using the placeholder") {


        when {
            process {
                """
                input[0] = Channel.of([
                    [group: 'TEST', subject: 'BROKEN', sample: 'BROKEN-T'],
                    file('${projectDir}/tests/modules/fixtures/purple_germline_broken.vcf.gz'),
                    file('${projectDir}/tests/modules/fixtures/purple_germline_broken.vcf.gz.tbi')
                ])
                input[1] = file('${projectDir}/assets/test_data/annotations')
                input[2] = file('${projectDir}/assets/test_data/reference')
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains('CPSR failed for BROKEN-T')
        }
    }
}

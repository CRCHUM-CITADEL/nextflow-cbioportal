nextflow_process {

    name "Test GENERATE_TIMELINE_STATUS module"
    script "modules/local/generate_timeline_status/main.nf"
    process "GENERATE_TIMELINE_STATUS"
    tag "module"
    tag "generate_timeline_status"

    test("Follow-ups — STATUS timeline rows are produced") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        [group: 'TEST'],
                        file('${projectDir}/assets/test_data/clinical/sample_registrations.csv'),
                        file('${projectDir}/assets/test_data/clinical/follow_ups.csv'),
                        [],
                        file('${projectDir}/assets/mohccn_clinical_data_modelv3-1_sep2024_primary_site.csv')
                    )
                )
                input[1] = file('${projectDir}/bin/clinical_common.R')
                """
            }
        }

        then {
            assert process.success
            assert process.out.ch_timeline_part.size() == 1

            def f = path(process.out.ch_timeline_part.collect { group, file -> file }[0].toString())
            def lines = f.readLines()
            assert lines[0].split('\t').toList() ==
                ['PATIENT_ID', 'START_DATE', 'STOP_DATE', 'EVENT_TYPE', 'STATUS', 'RELAPSE_TYPE',
                 'RELAPSE_DATE', 'METHOD_OF_PROGRESSION', 'SITE', 'SITE_LABEL']
            assert lines.size() > 1
            assert lines.drop(1).every { it.split('\t')[3] == 'STATUS' }
        }
    }

    test("No follow-ups provided — output file is created but empty") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        [group: 'TEST'],
                        file('${projectDir}/assets/test_data/clinical/sample_registrations.csv'),
                        [],
                        [],
                        file('${projectDir}/assets/mohccn_clinical_data_modelv3-1_sep2024_primary_site.csv')
                    )
                )
                input[1] = file('${projectDir}/bin/clinical_common.R')
                """
            }
        }

        then {
            assert process.success
            assert process.out.ch_timeline_part.size() == 1
            def f = path(process.out.ch_timeline_part.collect { group, file -> file }[0].toString())
            assert f.size() == 0
        }
    }
}

nextflow_workflow {

    name "Test GENOMIC_ML subworkflow"
    script "subworkflows/local/genomic_ml/main.nf"
    workflow "GENOMIC_ML"
    tag "subworkflow"
    tag "genomic_ml"

    // DOWNLOAD_KNOWN_FUSIONS is always called unconditionally inside this subworkflow.
    // Its stub block is used here to bypass the curl download while still running
    // all FORMAT_ML_* and PROCESS_ML_* modules with real containers.

    test("Group-level ML tables produced from precomputed fixtures") {

        options "-stub-run"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                // data_cna_long.txt: ml_format_cnv.R checks basename == 'data_cna_long.txt'
                // so the file must be staged with exactly that name (stageAs ensures it)
                input[0] = Channel.of(
                    ['TEST', file('${projectDir}/assets/test_data/precomputed/data_cna_long.txt')]
                )
                // data_expression.txt: ml_format_expression.R checks basename == 'data_expression.txt'
                input[1] = Channel.of(
                    ['TEST', file('${projectDir}/assets/test_data/precomputed/data_expression.txt')]
                )
                input[2] = Channel.of(
                    ['TEST', file('${projectDir}/assets/test_data/precomputed/data_mutations_dna_rna_germline.txt')]
                )
                input[3] = Channel.of(
                    ['TEST', file('${projectDir}/assets/test_data/precomputed/data_sv.txt')]
                )
                input[4] = ""   // cosmic_data (empty — skips FORMAT_PROCESS_ML_SV)
                input[5] = file('${projectDir}/assets/test_data/annotations/ChimerKB4.xlsx')
                input[6] = []   // hotspots_data (empty — PROCESS_ML_MUTATION falls back to a live fetch, stubbed here)
                """
            }
        }

        then {
            assert workflow.success
            // cosmic_data empty — the SV branch must not run at all
            def ran = workflow.trace.succeeded().collect { it.name }
            assert ran.every { !it.contains('FORMAT_PROCESS_ML_SV') }
        }
    }

    // Regression: the SV branch used to be gated on cosmic_data alone, so a run with
    // cosmic_data set and chimer_data empty reached FORMAT_PROCESS_ML_SV with an empty
    // `path known_fusions` and died with "Path must not be empty". Every existing test
    // passed cosmic_data = "" and never entered the branch.
    test("ML SV branch runs when both fusion databases are supplied") {

        options "-stub-run"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = Channel.of(
                    ['TEST', file('${projectDir}/assets/test_data/precomputed/data_cna_long.txt')]
                )
                input[1] = Channel.of(
                    ['TEST', file('${projectDir}/assets/test_data/precomputed/data_expression.txt')]
                )
                input[2] = Channel.of(
                    ['TEST', file('${projectDir}/assets/test_data/precomputed/data_mutations_dna_rna_germline.txt')]
                )
                input[3] = Channel.of(
                    ['TEST', file('${projectDir}/assets/test_data/precomputed/data_sv.txt')]
                )
                input[4] = file('${projectDir}/assets/test_data/annotations/cosmic_fusion_test.tsv')
                input[5] = file('${projectDir}/assets/test_data/annotations/ChimerKB4.xlsx')
                input[6] = []
                """
            }
        }

        then {
            assert workflow.success
            def ran = workflow.trace.succeeded().collect { it.name }
            assert ran.any { it.contains('FORMAT_PROCESS_ML_SV') }
        }
    }
}

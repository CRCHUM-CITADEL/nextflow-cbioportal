Bootstrap: docker
From: python:3.12-slim-bookworm

%post
    apt-get update && apt-get install -y --no-install-recommends \
        procps unzip gcc g++ zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev && \
        rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir \
        SigProfilerAssignment==1.1.3 \
        pandas==2.2.3 \
        scipy==1.14.0 \
        pysam==0.22.1

%environment
    export PYTHONNOUSERSITE=1

%labels
    Version 1.1.3
    Description SigProfilerAssignment for COSMIC v3.6 signature fitting (SBS, DBS, SV)

%runscript
    exec /bin/bash "$@"

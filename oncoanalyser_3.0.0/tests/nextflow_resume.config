// tests/resume.nf.test: stub run with one subject's tasks delayed, so the two runs finish in opposite
// orders. beforeScript is not part of the task hash. NFT_RESUME_SLOW picks the subject (default T1).
includeConfig 'nextflow_stub.config'

process.beforeScript = { task.tag?.toString()?.startsWith(System.getenv('NFT_RESUME_SLOW') ?: 'T1') ? 'sleep 3' : 'true' }

nextflow_process {

    name "Test WRITE_META"
    script "modules/local/write_meta/main.nf"
    process "WRITE_META"
    tag "module"

    // The gnomAD namespace makes cBioPortal import and show ANNOTATE_GNOMAD's gnomAD.AF column
    test("Declares the gnomAD namespace with filter_gnomad_af") {

        when {
            params {
                outdir           = "$outputDir"
                filter_gnomad_af = true
            }
            process {
                """
                input[0] = 'test_study'
                """
            }
        }

        then {
            assert process.success
            def meta = process.out[0][0].find { it.toString().endsWith('meta_mutations.txt') }
            assert path(meta.toString()).readLines().contains('namespaces: gnomAD')
        }
    }

    test("No namespace without filter_gnomad_af") {

        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = 'test_study'
                """
            }
        }

        then {
            assert process.success
            def meta = process.out[0][0].find { it.toString().endsWith('meta_mutations.txt') }
            assert !path(meta.toString()).text.contains('namespaces:')
        }
    }
}
